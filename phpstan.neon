includes:
    # Per-app tracked lint debt lives here (auto-generated via `phpstan --generate-baseline`).
    # Apps without debt ship an empty baseline file; canonical includes are otherwise byte-identical
    # across the fleet.
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - lib
    bootstrapFiles:
        - phpstan-bootstrap.php
    excludePaths:
        - vendor
        - vendor-bin
        # Apps that ship a verbatim template snapshot under lib/Resources/template/ (e.g. openbuilt).
        - lib/Resources/template
        # Extends AbstractIntegrationProvider from OCA\OpenRegister which is only
        # available at runtime (registered via IntegrationRegistry at app boot).
        # PHPStan cannot baseline "extends unknown class" errors — exclusion is required.
        - lib/Service/Integration/SynchronizationContractProvider.php
        # HealthController and MetricsController extend GenericHealthController /
        # GenericMetricsController from OCA\OpenRegister\AppHost which is only
        # available at runtime. PHPStan cannot baseline these "extends unknown class"
        # errors — exclusion is required (same pattern as SynchronizationContractProvider).
        - lib/Controller/HealthController.php
        - lib/Controller/MetricsController.php
        # adopt-apphost: Settings/OpenConnectorAdmin, Sections/OpenConnectorAdmin
        # and Repair/InitializeActions extend OCA\OpenRegister\AppHost generics
        # (GenericAdminSettings / GenericSettingsSection / GenericInitializeActions)
        # which are only available at runtime. Same "extends unknown class"
        # PHPStan limitation as HealthController/MetricsController above.
        - lib/Settings/OpenConnectorAdmin.php
        - lib/Sections/OpenConnectorAdmin.php
        - lib/Repair/InitializeActions.php
    scanDirectories:
        - vendor/nextcloud/ocp
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Nextcloud server internals (\OC, OC_App, OC\) not stubbed in nextcloud/ocp
        - '#Call to an undefined method OC::#'
        - '#Class OC not found#'
        - '#Access to static property \$server on an unknown class OC#'
        - '#unknown class OC\\#'
        - '#Caught class OC\\#'
        - '#unknown class OC_App#'
        - '#Class OC_App not found#'
        # flow-workflowengine-integration: NC's concrete IRequest implementation
        # (\OC\AppFramework\Http\Request), synthesized by
        # EndpointService::buildSyntheticRequest() (design.md Decision 5) — a
        # real, present-at-runtime NC core class not stubbed in nextcloud/ocp.
        - '#Instantiated class OC\\AppFramework\\Http\\Request not found#'
        - '#should return OCP\\IRequest but returns OC\\AppFramework\\Http\\Request#'
        # flow-workflowengine-integration: NC core's only bundled WorkflowEngine
        # IEntity, referenced only as a compile-time ::class string by the three
        # operation classes' getEntityId() (no autoload triggered).
        - '#Class OCA\\WorkflowEngine\\Entity\\File not found#'
        # OCA\DAV is server-internal and not in nextcloud/ocp stubs
        - '#unknown class OCA\\DAV\\#'
        - '#Class OCA\\DAV\\#'
        # nextcloud-event-hub: optional/bundled-app + newer-OCP event classes
        # referenced only via ::class / instanceof (safe when absent). OCA\Tables\
        # + OCA\Forms\ are optional App Store apps; OCP\Calendar\Events\ is real OCP
        # but @since 32.0.0, newer than the pinned nextcloud/ocp: dev-stable29 stub.
        - '#unknown class OCA\\Tables\\#'
        - '#Class OCA\\Tables\\#'
        - '#unknown class OCA\\Forms\\#'
        - '#Class OCA\\Forms\\#'
        - '#on an unknown class OCA\\Forms\\#'
        - '#unknown class OCP\\Calendar\\Events\\#'
        - '#Class OCP\\Calendar\\Events\\#'
        # OCA classes from other apps (OpenRegister) not available during static analysis
        - '#unknown class OCA\\OpenRegister\\#'
        - '#OCA\\OpenRegister\\[a-zA-Z\\]+.*not found#'
        - '#on an unknown class OCA\\OpenRegister\\#'
        - '#has invalid return type OCA\\OpenRegister\\#'
        - '#has invalid type OCA\\OpenRegister\\#'
        - '#implements unknown interface OCA\\OpenRegister\\#'
        # GuzzleHttp is available at runtime via Nextcloud but not in composer require
        - '#unknown class GuzzleHttp\\#'
        - '#GuzzleHttp\\[a-zA-Z\\]+.*not found#'
        - '#on an unknown class GuzzleHttp\\#'
        - '#invalid type GuzzleHttp\\#'
        - '#Caught class GuzzleHttp\\#'
        # Doctrine\DBAL is shipped by Nextcloud server but not stubbed in nextcloud/ocp
        - '#unknown class Doctrine\\DBAL\\#'
        - '#Doctrine\\DBAL\\[a-zA-Z\\]+.*not found#'
        - '#on an unknown class Doctrine\\DBAL\\#'
        # Dynamic HTTP status codes from business rule validation results
        # (matches both `Parameter $statusCode` and `Parameter #N $statusCode` forms emitted by phpstan)
        - '#Parameter (\#\d+ )?\$statusCode of class OCP\\AppFramework\\Http\\JSONResponse constructor expects#'
        # registerRepairStep exists on server; not yet in nextcloud/ocp stub used for analysis
        - '#Call to an undefined method OCP\\AppFramework\\Bootstrap\\IRegistrationContext::registerRepairStep#'
        # OCP stub gaps for methods that exist at runtime
        - '#Call to an undefined method OCP\\IRequest::getContent\(\)#'
        - '#Call to an undefined method OCP\\IRequest::setParameter\(\)#'
        - '#Call to an undefined method OCP\\Mail\\IMessage::attachFile\(\)#'
        - '#Call to an undefined method OCP\\AppFramework\\Db\\Entity::jsonSerialize#'
        # HealthController and MetricsController are excluded from analysis (they extend
        # unknown OR classes) — Application.php registers them via DI without knowing
        # the parent constructor. The "does not have a constructor" error in Application.php
        # is a downstream effect of the excludePaths exclusion.
        - '#Class OCA\\OpenConnector\\Controller\\HealthController does not have a constructor#'
        - '#Class OCA\\OpenConnector\\Controller\\MetricsController does not have a constructor#'
        # adopt-apphost: same downstream effect for Settings/OpenConnectorAdmin,
        # Sections/OpenConnectorAdmin and Repair/InitializeActions (see excludePaths above).
        - '#Class OCA\\OpenConnector\\Settings\\OpenConnectorAdmin does not have a constructor#'
        - '#Class OCA\\OpenConnector\\Sections\\OpenConnectorAdmin does not have a constructor#'
        - '#Class OCA\\OpenConnector\\Repair\\InitializeActions does not have a constructor#'
