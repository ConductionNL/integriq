# OpenConnector — Conduction PHPStan config.
#
# The shared base is the single source of truth. Everything here is either the
# app's own tracked debt or an ignore naming a symbol that exists in no other
# fleet app. Anything you are tempted to add that another app would also need
# belongs in the base, not here.
includes:
    - vendor/conduction/hydra-gates/quality-config/phpstan-base.neon
    # Per-app tracked lint debt (auto-generated via `phpstan --generate-baseline`).
    - phpstan-baseline.neon

parameters:
    # App-specific only. The base already sets level, paths, bootstrapFiles,
    # excludePaths, scanDirectories and every fleet-wide ignore.
    excludePaths:
        # Extends AbstractIntegrationProvider from OCA\OpenRegister which is only
        # available at runtime (registered via IntegrationRegistry at app boot).
        # PHPStan cannot baseline "extends unknown class" errors — exclusion is required.
        - lib/Service/Integration/SynchronizationContractProvider.php
        # HealthController and MetricsController extend GenericHealthController /
        # GenericMetricsController from OCA\OpenRegister\AppHost which is only
        # available at runtime. PHPStan cannot baseline these "extends unknown class"
        # errors — exclusion is required (same pattern as SynchronizationContractProvider).
        - lib/Controller/HealthController.php
        - lib/Controller/MetricsController.php
        # adopt-apphost: Settings/OpenConnectorAdmin, Sections/OpenConnectorAdmin
        # and Repair/InitializeActions extend OCA\OpenRegister\AppHost generics
        # (GenericAdminSettings / GenericSettingsSection / GenericInitializeActions)
        # which are only available at runtime. Same "extends unknown class"
        # PHPStan limitation as HealthController/MetricsController above.
        - lib/Settings/OpenConnectorAdmin.php
        - lib/Sections/OpenConnectorAdmin.php
        - lib/Repair/InitializeActions.php
        # The contributed flow nodes and their registration listener implement /
        # reference OCA\OpenRegister\Service\Flow\* (IFlowNode,
        # RegisterFlowNodesEvent), which exists only at runtime and only on an
        # OpenRegister that ships the flow engine — that is precisely what the
        # class_exists() guard in Application::registerFlowNodes() is for.
        # "implements unknown interface" cannot be baselined, so exclusion is
        # required (same pattern as SynchronizationContractProvider above). The
        # flow helpers that do NOT touch OpenRegister types (FlowConfigGuard,
        # FlowNodeSupport, FlowOwner, FlowTemplate) stay analysed.
        - lib/Flow/FlowNodeListener.php
        - lib/Flow/SourceCallNode.php
        - lib/Flow/SynchronizationRunNode.php
        # flow-native-synchronization: the four page-level sync nodes implement
        # the same runtime-only OCA\OpenRegister\Service\Flow\* interfaces
        # (IFlowNode, IFlowNodeConfigKeys, IFlowNodeConfigForm) and build their
        # output through FlowItems — same limitation, same remedy.
        - lib/Flow/ApplyMappingNode.php
        - lib/Flow/ContractMatchNode.php
        - lib/Flow/ContractCommitNode.php
        - lib/Flow/ContractSweepNode.php
        # flow-native-synchronization task 1.1: the page-fetch node implements the
        # same runtime-only interfaces, and FlowRateLimit returns an
        # OCA\OpenRegister\Service\Flow\FlowSuspension — same limitation, same
        # remedy.
        - lib/Flow/SourcePaginateNode.php
        - lib/Flow/FlowRateLimit.php
        # SynchronizationLogActions is the run-log helper the four flow nodes
        # above share. Every one of its users is excluded, so PHPStan sees a
        # trait that is "used zero times and is not analysed" — which it refuses
        # to let a baseline or ignoreErrors absorb. It is excluded for exactly
        # the same reason its users are, not because the trait itself is
        # unreachable: at runtime all four nodes `use` it.
        - lib/Flow/SynchronizationLogActions.php
        # OpenConnectorMetricsProvider implements OCA\OpenRegister\AppHost\IMetricsProvider
        # and AbstractCategoryAdapterProvider extends
        # OCA\OpenRegister\Service\Integration\AbstractIntegrationProvider — both peer-app
        # types that exist only at runtime. PHPStan reports these as *general* errors
        # ("cannot be ignored, use excludePaths instead"), which no baseline can absorb:
        # they abort the run regardless of ignoreErrors. Same pattern as
        # SynchronizationContractProvider above and opencatalogi's metrics provider.
        - lib/Observability/OpenConnectorMetricsProvider.php
        - lib/Service/Adapter/AbstractCategoryAdapterProvider.php
        # DeferredViewCascadeJob extends OCA\OpenRegister\BackgroundJob\ActorForwardedJob,
        # the ADR-078 actor-forwarding deferral base, which exists only at runtime.
        # "extends unknown class" is a *general* error PHPStan refuses to baseline —
        # same limitation, same remedy, as SynchronizationContractProvider above.
        - lib/Cron/DeferredViewCascadeJob.php

    ignoreErrors:
        # flow-workflowengine-integration: NC's concrete IRequest implementation
        # (\OC\AppFramework\Http\Request), synthesized by
        # EndpointService::buildSyntheticRequest() (design.md Decision 5) — a
        # real, present-at-runtime NC core class not stubbed in nextcloud/ocp.
        - '#Instantiated class OC\\AppFramework\\Http\\Request not found#'
        - '#should return OCP\\IRequest but returns OC\\AppFramework\\Http\\Request#'
        # flow-workflowengine-integration: NC core's only bundled WorkflowEngine
        # IEntity, referenced only as a compile-time ::class string by the three
        # operation classes' getEntityId() (no autoload triggered).
        - '#Class OCA\\WorkflowEngine\\Entity\\File not found#'
        # nextcloud-event-hub: optional-app event classes (Tables, Forms) referenced
        # only via ::class / instanceof, safe when the app is absent.
        - '#unknown class OCA\\Tables\\#'
        - '#Class OCA\\Tables\\#'
        - '#unknown class OCA\\Forms\\#'
        - '#Class OCA\\Forms\\#'
        - '#on an unknown class OCA\\Forms\\#'
        # Downstream effect of the SAME OpenRegister-is-runtime-only limitation.
        # These controllers build their JSON payload out of values that came from
        # OCA\OpenRegister types — ObjectService::find()/findAll() results, OR
        # exception accessors. Because OpenRegister is not on the analysis path,
        # those expressions resolve to an error type, and PHPStan then reports the
        # whole `new JSONResponse($data)` argument as unresolvable rather than
        # reporting the OR symbol itself (which the base already ignores).
        #
        # Scoped to the files where this actually happens, not the identifier
        # globally, so a genuinely unresolvable payload elsewhere still fails.
        # Every path listed here references OCA\OpenRegister; re-check that before
        # adding another.
        -
            message: '#Parameter \#?1? ?\$data of class OCP\\AppFramework\\Http\\JSONResponse constructor contains unresolvable type#'
            identifier: argument.unresolvableType
            paths:
                - lib/Controller/ApprovalsController.php
                - lib/Controller/DSOController.php
                - lib/Controller/EventsController.php
                - lib/Controller/JobsController.php
                - lib/Controller/LogsController.php
                - lib/Controller/OpenFormulierenController.php
                - lib/Controller/SourcesController.php
                - lib/Controller/SynchronizationsController.php
                - lib/Service/EndpointService.php
        # MappingService::executeMapping()'s `is_array($output) === false` guard.
        # The comment directly above it already records the situation: "The
        # is_array() guard is dead per static analysis but kept for safety
        # against future refactors." Honouring that decision rather than
        # overriding it in a lint pass.
        -
            message: '#Call to function is_array\(\) with array will always evaluate to true#'
            identifier: function.alreadyNarrowedType
            path: lib/Service/MappingService.php

        # processSynchronizationObject()'s "source item is not an array" branch
        # (the `invalid: N` diagnostic) is unreachable: the method declares
        # `array $object`, so PHP rejects a non-array at the call boundary before
        # the guard can run. The branch's own comment says it exists because "the
        # source empty values or string might be returned", which the signature
        # then makes impossible.
        #
        # Ignored rather than deleted because the fix is a DECISION, not a
        # cleanup: either widen the parameter to `mixed` so the diagnostic works
        # as intended, or drop the branch and accept that malformed source items
        # fatal at the boundary. Both change behaviour of the sync engine, so
        # they belong to whoever owns it. Scoped to this one file.
        -
            message: '#Call to function is_(array|scalar)\(\) with (array|\*NEVER\*) will always evaluate to true#'
            identifier: function.alreadyNarrowedType
            path: lib/Service/SynchronizationService.php

        # @throws referencing an OpenRegister exception class. PHPStan cannot resolve the
        # class to verify it is Throwable because OCA\OpenRegister is not on the analysis
        # path (see the base's OpenRegister ignores).
        - '#PHPDoc tag @throws with type OCA\\OpenRegister\\.*is not subtype of Throwable#'
        # HealthController and MetricsController are excluded from analysis (they extend
        # unknown OR classes) — Application.php registers them via DI without knowing
        # the parent constructor. The "does not have a constructor" error in Application.php
        # is a downstream effect of the excludePaths exclusion.
        - '#Class OCA\\OpenConnector\\Controller\\HealthController does not have a constructor#'
        - '#Class OCA\\OpenConnector\\Controller\\MetricsController does not have a constructor#'
        # Downstream effect of the lib/Settings/OpenConnectorAdmin.php exclusion above.
        # Every #[AuthorizedAdminSetting(OpenConnectorAdmin::class)] attribute resolves to
        # a plain `string` for PHPStan because the class is excluded from analysis, so it
        # cannot see that OpenConnectorAdmin -> GenericAdminSettings implements
        # OCP\Settings\IDelegatedSettings. The attribute IS correct at runtime; this is an
        # artifact of excluding the class, not a real type error. 41 occurrences.
        - '#Parameter \#1 \$settings of attribute class OCP\\AppFramework\\Http\\Attribute\\AuthorizedAdminSetting constructor expects class-string<OCP\\Settings\\IDelegatedSettings>, string given\.#'
        # adopt-apphost: same downstream effect for Settings/OpenConnectorAdmin,
        # Sections/OpenConnectorAdmin and Repair/InitializeActions (see excludePaths above).
        - '#Class OCA\\OpenConnector\\Settings\\OpenConnectorAdmin does not have a constructor#'
        - '#Class OCA\\OpenConnector\\Sections\\OpenConnectorAdmin does not have a constructor#'
        - '#Class OCA\\OpenConnector\\Repair\\InitializeActions does not have a constructor#'
