{
    "@context": {
        "schema": "http:\/\/schema.org",
        "register": "decidesk"
    },
    "@type": "mapping",
    "@id": "https:\/\/openconnector.app\/mappings\/ibabs-vergadering-to-decidesk-meeting",
    "reference": "https:\/\/openconnector.app\/mappings\/ibabs-vergadering-to-decidesk-meeting",
    "name": "iBabs Vergadering to decidesk Meeting",
    "description": "Maps an iBabs vergadering (RIS meeting) onto decidesk's ORI-aligned Meeting schema. Source fields follow the iBabs vergadering payload (titel/onderwerp, datum, locatie). Lifecycle defaults to scheduled; chair/quorum are not present in the public feed and are left unset.",
    "version": "0.0.1",
    "mapping": {
        "title": "{{ values.titel ?? values.onderwerp ?? values.naam }}",
        "meetingType": "{{ values.vergadertype ?? 'regular' }}",
        "scheduledDate": "{{ values.datum ?? values.date ?? values.startdatum }}",
        "endDate": "{{ values.einddatum ?? values.endDate }}",
        "location": "{{ values.locatie ?? values.location }}",
        "meetingMode": "in-person",
        "lifecycle": "scheduled",
        "isPublic": true,
        "subjectRegister": "ibabs",
        "subjectSchema": "vergadering",
        "subjectId": "{{ values.id ?? values.vergaderingId }}",
        "subjectLabel": "{{ values.titel ?? values.onderwerp }}",
        "externalReference": "{{ 'ibabs-vergadering-' ~ (values.id ?? values.vergaderingId) }}"
    },
    "unset": [
        ""
    ],
    "cast": {
        "title": "unsetIfValue==",
        "scheduledDate": "unsetIfValue==",
        "endDate": "unsetIfValue==",
        "location": "unsetIfValue==",
        "subjectId": "unsetIfValue=="
    },
    "passThrough": false
}
