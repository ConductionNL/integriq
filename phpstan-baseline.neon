# PHPStan baseline — tracked lint debt for openconnector
#
# Burndown tracked at: https://github.com/ConductionNL/openconnector/issues/848
# Remove entries here as the underlying code is fixed.
parameters:
	ignoreErrors:
		# AuthorizedAdminSetting accepts APP_ID string (not a class-string<IDelegatedSettings>)
		# because NC's middleware resolves admin-gating by app ID at runtime, not by the
		# IDelegatedSettings interface. This is the fleet-wide usage pattern.
		# phpstan could not run locally (azjezz/psl v4 / PHP 8.2 incompatibility) — count
		# validated on CI (PHP 8.3). Tracked in: https://github.com/ConductionNL/openconnector/issues/990
		-
			message: "#^Expression on left side of \\?\\? is not nullable\\.$#"
			count: 1
			path: lib/Controller/SynchronizationsController.php

		-
			message: "#^Call to an undefined method OCP\\\\IUserSession\\:\\:createSessionToken\\(\\)\\.$#"
			count: 1
