; Nextcloud core ships one of these; without it an editor falls back to
; whatever the developer last configured, and the repo's own indentation
; becomes a property of who opened it rather than of the project.
;
; Values follow what this repo already contains: tabs in PHP/JS/Vue, and the
; two-space YAML/JSON that every tool here emits.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{yml,yaml,json,jsonc}]
indent_style = space
indent_size = 2

[*.md]
; Trailing whitespace is a hard line break in Markdown, so trimming it changes
; rendered output rather than tidying it.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
