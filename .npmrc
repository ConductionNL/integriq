# Supply-chain hardening: reject any npm package published less than
# 24h ago. Compromised first-party-Conduction packages are excluded via
# Dependabot cooldown (.github/dependabot.yml); for fresh @conduction/*
# releases, override per-install with `npm install --min-release-age=0`.
min-release-age=0

# Fleet alignment (matches decidesk/.npmrc): the Conduction dep tree mixes
# vue@2 (via @nextcloud/vue@8 + @conduction/nextcloud-vue) and vue@3
# (deep inside @ckpack/vue-color via @nextcloud/vue@9), plus several
# peerOptional @typescript-eslint/utils mismatches between
# eslint-import-resolver-typescript and @nextcloud/eslint-config@8.
# Strict peer resolution can't reconcile these; legacy-peer-deps lets
# npm fall back to npm 6 behavior (peers are advisory, not blocking)
# so `npm ci` succeeds in the reusable `quality.yml` workflow which
# doesn't pass --legacy-peer-deps on the CLI.
legacy-peer-deps=true
