<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>openconnector</id>
	<name>Open Connector</name>
	<summary>Gateway and Service bus functionality</summary>
	<description><![CDATA[📰 Bringing Gateway and Service bus functionality to nextcloud

The OpenConnector Nextcloud app provides a ESB-framework to work together in an (open) data ecosystem

- 📲 Synchronize your data sources
- 📰 Send cloud events
- 🆓 Map and translate API calls

    ]]></description>
	<version>0.2.16</version>
	<licence>EUPL-1.2</licence>
	<category>integration</category>
	<author mail="info@conduction.nl" homepage="https://www.conduction.nl/">Conduction</author>
	<namespace>OpenConnector</namespace>
    <website>https://codeberg.org/Conduction/openconnector</website>
	<bugs>https://codeberg.org/Conduction/openconnector/issues</bugs>
    <repository>https://codeberg.org/Conduction/openconnector</repository>
    <screenshot>https://codeberg.org/Conduction/openconnector/raw/branch/main/img/screenshot-dashboard.png</screenshot>
    <screenshot>https://codeberg.org/Conduction/openconnector/raw/branch/main/img/screenshot-sources.png</screenshot>
    <screenshot>https://codeberg.org/Conduction/openconnector/raw/branch/main/img/screenshot-mappings.png</screenshot>
	<dependencies>
        <nextcloud min-version="28" max-version="34"/>
        <php min-version="8.0" min-int-size="64"/>
        <database min-version="10">pgsql</database>
        <database>sqlite</database>
        <database min-version="8.0">mysql</database>

        <lib>curl</lib>

        <owncloud max-version="0" min-version="0"/>
	</dependencies>

	<background-jobs>
		<job>OCA\OpenConnector\Cron\JobTask</job>
		<job>OCA\OpenConnector\Cron\LogCleanUpTask</job>
		<job>OCA\OpenConnector\Cron\EventRetryJob</job>
	</background-jobs>

	<commands>
		<!-- Chain B storage migration: operator entrypoint for the legacy → OpenRegister
		     row migration (dry-run, per-entity retry, verify). -->
		<command>OCA\OpenConnector\Command\MigrateToOpenRegister</command>
	</commands>

	<repair-steps>
		<post-migration>
			<step>OCA\OpenConnector\Repair\InitializeRegister</step>
			<step>OCA\OpenConnector\Repair\InitializeActions</step>
		</post-migration>
	</repair-steps>

	<navigations>
		<navigation>
			<id>openconnector</id>
			<name>Connector</name>
			<route>openconnector.ui.dashboard</route>
			<icon>app.svg</icon>
		</navigation>
	</navigations>

	<settings>
		<admin>OCA\OpenConnector\Settings\OpenConnectorAdmin</admin>
		<admin-section>OCA\OpenConnector\Sections\OpenConnectorAdmin</admin-section>
	</settings>
</info>
