<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>openconnector</id>
	<name>Open Connector</name>
	<summary lang="en">API gateway and data-synchronization layer for Nextcloud</summary>
	<summary lang="nl">API-gateway en data-synchronisatielaag voor Nextcloud</summary>
	<description lang="en"><![CDATA[OpenConnector is the integration layer for Nextcloud. It connects REST and SOAP sources — including Dutch government standards such as PDOK, StUF-ZKN/BG, DSO/Omgevingsloket, and Berichtenbox — to typed OpenRegister stores.

- 🔌 Configure sources, endpoints and consumers with shared authentication (API key, OAuth, JWT)
- 🗺️ Map and transform payloads with the built-in mapping engine
- ⏱️ Schedule synchronization jobs with webhook, cron, or manual triggers
- ☁️ Dispatch and receive CloudEvents with dead-letter capture and one-click replay
- 📋 Apply business rules to endpoint traffic and keep a per-object audit trail

    ]]></description>
	<description lang="nl"><![CDATA[OpenConnector is de integratielaag voor Nextcloud. De app koppelt REST- en SOAP-bronnen — waaronder Nederlandse overheidsstandaarden zoals PDOK, StUF-ZKN/BG, DSO/Omgevingsloket en Berichtenbox — aan getypeerde OpenRegister-registers.

- 🔌 Configureer bronnen, endpoints en consumenten met gedeelde authenticatie (API-key, OAuth, JWT)
- 🗺️ Transformeer gegevens met de ingebouwde mapping-engine
- ⏱️ Plan synchronisatietaken met webhook-, cron- of handmatige triggers
- ☁️ Verstuur en ontvang CloudEvents met dead-letter-opvang en replay met één klik
- 📋 Pas bedrijfsregels toe op endpoint-verkeer en houd een audit trail per object bij

    ]]></description>
	<version>0.3.4</version>
	<licence>EUPL-1.2</licence>
	<author mail="info@conduction.nl" homepage="https://www.conduction.nl/">Conduction</author>
	<namespace>OpenConnector</namespace>
	<category>integration</category>
    <website>https://codeberg.org/Conduction/openconnector</website>
	<bugs>https://codeberg.org/Conduction/openconnector/issues</bugs>
    <repository>https://codeberg.org/Conduction/openconnector</repository>
    <screenshot>https://codeberg.org/Conduction/openconnector/raw/branch/main/img/screenshot-dashboard.png</screenshot>
    <screenshot>https://codeberg.org/Conduction/openconnector/raw/branch/main/img/screenshot-sources.png</screenshot>
    <screenshot>https://codeberg.org/Conduction/openconnector/raw/branch/main/img/screenshot-mappings.png</screenshot>
	<dependencies>
        <!--
        App dependency: openregister. Recorded as prose, not as an element. The
        App Store schema (info.xsd) has no app child under dependencies, so
        shipping one fails App Store validation; Nextcloud's DependencyAnalyzer
        does not read it either (it handles only php, database, command, lib,
        os, architecture and the server version), so the element never enforced
        anything at install time.
        -->
        <php min-version="8.3" min-int-size="64"/>
        <database min-version="10">pgsql</database>
        <database>sqlite</database>
        <database min-version="8.0">mysql</database>

        <lib>curl</lib>

        <owncloud max-version="0" min-version="0"/>
        <!--
        min-version is 32, NOT 28, because the openregister app dependency noted
        above is a HARD dependency and openregister declares min-version="32". On NC 28-31 openregister
        refuses to install ("cannot be installed because it is not compatible with this
        version of the server"), and every openconnector entity is an OpenRegister
        object — so the app cannot function there. Declaring 28 advertised a range
        this app cannot deliver. See issue #1172.

        max-version is 34, NOT 35, for the same "do not advertise a range you
        cannot deliver" reason in the other direction: NC 35 does not exist —
        there is no tag, no branch, and this app's own CI matrix has no leg past
        stable33. The rest of the fleet declares 34; openconnector was the only
        repo claiming 35, so the claim was untested everywhere it mattered.
        -->
        <nextcloud min-version="32" max-version="34"/>
	</dependencies>

	<background-jobs>
		<!-- ADR-076 rule 4: the register bootstrap used to run from
		     Application::boot() as a fallback for the InitializeRegister repair
		     step possibly not having run. Gated, but one unset config key away
		     from a repair step on every request. Hourly cron instead. -->
		<job>OCA\OpenConnector\Cron\RegisterBootstrapJob</job>
		<job>OCA\OpenConnector\Cron\JobTask</job>
		<job>OCA\OpenConnector\Cron\LogCleanUpTask</job>
		<job>OCA\OpenConnector\Cron\EventRetryJob</job>
		<job>OCA\OpenConnector\Cron\LtiKeyRetirementJob</job>
		<job>OCA\OpenConnector\Cron\BankfeedSyncJob</job>
		<job>OCA\OpenConnector\Cron\CardfeedSyncJob</job>
		<job>OCA\OpenConnector\Cron\EudiStatusListRefreshJob</job>
		<job>OCA\OpenConnector\Cron\KissPullJob</job>
		<job>OCA\OpenConnector\Cron\ApprovalTimeoutSweepJob</job>
		<job>OCA\OpenConnector\Cron\IwmoIjwRetryJob</job>
		<job>OCA\OpenConnector\Cron\StufZknRetryJob</job>
	</background-jobs>

	<repair-steps>
		<post-migration>
			<step>OCA\OpenConnector\Repair\InitializeRegister</step>
			<step>OCA\OpenConnector\Repair\InitializeActions</step>
			<step>OCA\OpenConnector\Repair\FlagSourceSecretsWriteOnly</step>
			<!-- ocon#151 phase C / ADR-064: RUNS the inline-secret migration (mint,
			     verify, write credentialRef, null the inline value) now that
			     organisation-scope resolution is unblocked (openregister#450/#440),
			     then records whether any source still holds an inline secret into
			     appconfig (the Phase D gate). Fail-closed and non-fatal; see the
			     repair step's docblock. -->
			<step>OCA\OpenConnector\Repair\RecordInlineSecretMigrationStatus</step>
			<!-- ocon#151 phase D: IRREVERSIBLE. Removes the four auto-migratable
			     secret fields (apikey, secret, password, jwt) from the LIVE source
			     schema ONLY once every source is verifiably clean of inline values in
			     them. Runs AFTER the migration above so the gate can be clean.
			     authenticationConfig is excluded (manual review). The register JSON
			     keeps all five fields on purpose (see the step's docblock). -->
			<step>OCA\OpenConnector\Repair\RemoveMigratedSourceSecretFields</step>
			<step>OCA\OpenConnector\Repair\MaterializeCatalogItems</step>
		</post-migration>
	</repair-steps>

	<commands>
		<!-- Chain B storage migration: operator entrypoint for the legacy → OpenRegister
		     row migration (dry-run, per-entity retry, verify). -->
		<command>OCA\OpenConnector\Command\MigrateToOpenRegister</command>
		<!-- ocon#151 phase C / ADR-064: reports which sources still hold an inline
		     secret and what each would become in the credential broker. The dry-run
		     mode writes nothing and emits the "clean" gate phase D must check before
		     it may remove the schema properties. A real run migrates inline secrets.
		     (XML comments must not contain a double hyphen, so the dry-run flag is
		     not written with its leading dashes here.) -->
		<command>OCA\OpenConnector\Command\MigrateInlineSecrets</command>
		<!-- ocon#232 (ocon#151 follow-up): audits the VESTIGIAL source
		     authenticationConfig field. No code authenticates from it, so removal
		     (not a credentialRef migration) is the correct treatment. The default
		     action is a READ ONLY audit reporting key NAMES only, never values.
		     Removal DELETES credential data and therefore happens only when a human
		     passes the explicit opt in flag; it is registered here as a command and
		     never as a repair step, so an upgrade or maintenance:repair can never
		     reach the deleting path.
		     (XML comments must not contain a double hyphen, so the flags are not
		     written with their leading dashes here.) -->
		<command>OCA\OpenConnector\Command\AuthenticationConfig</command>
	</commands>

	<settings>
		<admin>OCA\OpenConnector\Settings\OpenConnectorAdmin</admin>
		<admin-section>OCA\OpenConnector\Sections\OpenConnectorAdmin</admin-section>
	</settings>

	<navigations>
		<navigation>
			<id>openconnector</id>
			<name>Connector</name>
			<route>openconnector.ui.dashboard</route>
			<icon>app.svg</icon>
		</navigation>
	</navigations>
</info>
