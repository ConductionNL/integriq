{
  "name": "openconnector",
  "version": "1.0.0",
  "license": "EUPL-1.2",
  "engines": {
    "node": "^20.0.0",
    "npm": "^10.0.0"
  },
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "lint": "eslint src",
    "lint-fix": "npm run lint -- --fix",
    "test": "jest --silent",
    "test-coverage": "jest --silent --coverage",
    "test:e2e": "playwright test",
    "test:e2e:docs": "playwright test --project docs-capture",
    "stylelint": "stylelint src/**/*.vue src/**/*.scss src/**/*.css",
    "check:manifest": "node -e \"const {validateManifestV2}=require('@conduction/nextcloud-vue/dist/utils.cjs.js');const m=require('./src/manifest.json');const r=validateManifestV2(m);if(!r.valid){console.error(JSON.stringify(r.errors,null,2));process.exit(1)}console.log('manifest.json valid')\"",
    "test:newman": "newman run tests/postman/openconnector.postman_collection.json --environment tests/postman/openconnector.postman_environment.json --reporters cli,json --reporter-json-export tests/postman/newman-report.json",
    "test:regression": "playwright test --project regression"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@codemirror/lang-json": "^6.0.1",
    "@conduction/nextcloud-vue": "^1.0.0-beta.65",
    "@fortawesome/fontawesome-svg-core": "^6.5.2",
    "@fortawesome/free-solid-svg-icons": "^6.5.2",
    "@mdi/js": "^7.4.47",
    "@nextcloud/axios": "~2.5.2",
    "@nextcloud/dialogs": "^3.2.0",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^2.0.1",
    "@nextcloud/router": "^2.0.1",
    "@nextcloud/vue": "^8.12.0",
    "@vueuse/core": "^11.0.0",
    "apexcharts": "^3.50.0",
    "axios": "^1.7.3",
    "bootstrap-vue": "^2.23.1",
    "css-loader": "~7.1.1",
    "lodash": "^4.17.21",
    "pinia": "^2.1.7",
    "remark-cli": "^12.0.1",
    "remark-lint-list-item-indent": "^4.0.0",
    "remark-preset-lint-consistent": "^6.0.0",
    "remark-preset-lint-recommended": "^7.0.0",
    "style-loader": "~4.0.0",
    "vue": "^2.7.14",
    "vue-apexcharts": "~1.6.2",
    "vue-codemirror6": "^1.3.8",
    "vue-draggable-plus": "^0.6.0",
    "vue-loader": "^15.11.1 <16.0.0",
    "vue-loading-overlay": "^3.4.3",
    "vue-material-design-icons": "^5.3.1",
    "vue-router": "^3.6.5",
    "vue-template-compiler": "^2.7.16",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.3",
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@eslint/config-helpers": "^0.4.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^8.4.1",
    "@nextcloud/eslint-plugin": "^2.2.1",
    "@nextcloud/stylelint-config": "^2.4.0",
    "@nextcloud/webpack-vue-config": "^6.0.1",
    "@pinia/testing": "^0.1.3",
    "@playwright/test": "^1.59.1",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.14",
    "@types/node": "^20.14.12",
    "@typescript-eslint/parser": "^7.18.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/vue2-jest": "^29.0.0",
    "@babel/core": "^7.24.5",
    "@babel/eslint-parser": "^7.24.5",
    "@vue/eslint-config-typescript": "^13.0.0",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^46.10.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-vue": "^9.32.0",
    "eslint-webpack-plugin": "^4.2.0",
    "espree": "^11.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "node-polyfill-webpack-plugin": "^4.0.0",
    "sass": "^1.77.0",
    "sass-loader": "^16.0.4",
    "postcss-html": "^1.7.0",
    "stylelint": "^15.11.0",
    "stylelint-config-recommended-scss": "^13.1.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-webpack-plugin": "^5.0.1",
    "ts-jest": "^29.2.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-jest": "^3.0.7",
    "webpack": "^5.88.2",
    "webpack-cli": "^6.0.1"
  },
  "overrides": {
    "@vue/test-utils": {
      "vue": "$vue"
    },
    "@nextcloud/axios": "~2.5.2",
    "@vueuse/core": "^11.0.0",
    "@vueuse/shared": "^11.0.0",
    "@conduction/nextcloud-vue": {
      "@vueuse/core": "^11.0.0",
      "@vueuse/shared": "^11.0.0"
    },
    "postcss": "^8.4.49"
  }
}
