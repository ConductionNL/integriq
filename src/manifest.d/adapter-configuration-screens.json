{
  "$comment": "ADR-037 manifest fragment (adapter-configuration-screens, task 4). Manifest-driven index pages over the four single-record configurations an administrator owns. Placement follows the proposal's answer to open question 3: by data direction (src/menu-layout.json), so the outbound FSC services, bank feeds and card feeds sit under Connections and the inbound Open Formulieren forms under Gateway. Every column is a property its schema declares. Tasks 2 and 3 add the LTI platform and tool index and detail pages, inbound, under Gateway, with the four lifecycle actions on the records they act on.",
  "pages": [
    {
      "id": "FscServices",
      "route": "/fsc-services",
      "type": "index",
      "title": "FSC services",
      "permission": "admin",
      "config": {
        "register": "integriq",
        "schema": "fsc_service",
        "columns": ["organisation", "service", "endpoint", "grantRequired", "resolvedAt"],
        "sidebar": {
          "enabled": true,
          "showMetadata": true
        },
        "showViewAction": false,
        "showEditAction": true,
        "documentationUrl": "https://integriq.conduction.nl"
      }
    },
    {
      "id": "BankfeedConnections",
      "route": "/bank-feeds",
      "type": "index",
      "title": "Bank feeds",
      "permission": "admin",
      "config": {
        "register": "integriq",
        "schema": "bankfeed_connection",
        "columns": ["connectionId", "aggregator", "lifecycleState", "consentExpiresAt", "lastSyncAt"],
        "sidebar": {
          "enabled": true,
          "showMetadata": true
        },
        "showViewAction": false,
        "showEditAction": true,
        "documentationUrl": "https://integriq.conduction.nl"
      }
    },
    {
      "id": "CardfeedAccounts",
      "route": "/card-feeds",
      "type": "index",
      "title": "Card feeds",
      "permission": "admin",
      "config": {
        "register": "integriq",
        "schema": "cardfeed_account",
        "columns": ["accountId", "provider", "lifecycleState", "lastSyncAt"],
        "sidebar": {
          "enabled": true,
          "showMetadata": true
        },
        "showViewAction": false,
        "showEditAction": true,
        "documentationUrl": "https://integriq.conduction.nl"
      }
    },
    {
      "id": "OpenFormulierenForms",
      "route": "/open-formulieren-forms",
      "type": "index",
      "title": "Open Formulieren forms",
      "permission": "admin",
      "config": {
        "register": "integriq",
        "schema": "openformulieren_form_mapping",
        "columns": ["formSlug", "formUuid", "description", "isEnabled"],
        "sidebar": {
          "enabled": true,
          "showMetadata": true
        },
        "showViewAction": false,
        "showEditAction": true,
        "documentationUrl": "https://integriq.conduction.nl"
      }
    },
    {
      "id": "LtiPlatforms",
      "route": "/lti-platforms",
      "type": "index",
      "title": "LTI platforms",
      "permission": "admin",
      "config": {
        "register": "integriq",
        "schema": "lti_platform",
        "columns": ["name", "issuer", "clientId", "status", "identityPolicy", "updated"],
        "includeFields": ["name", "description", "issuer", "clientId", "authLoginUrl", "authTokenUrl", "jwksUri", "identityPolicy", "defaultProvisionGroup"],
        "sidebar": {
          "enabled": true,
          "showMetadata": true
        },
        "showViewAction": false,
        "actions": [
          {
            "id": "view",
            "label": "View",
            "icon": "EyeOutline",
            "handler": "navigate",
            "route": "LtiPlatformDetail"
          },
          {
            "id": "approve",
            "label": "Approve",
            "icon": "CheckCircleOutline",
            "type": "api-call",
            "url": "/apps/integriq/api/lti/lti_platform/@objectId/approve",
            "method": "POST",
            "successMessage": "The platform is approved.",
            "visibleWhen": {
              "field": "status",
              "op": "neq",
              "value": "approved"
            }
          },
          {
            "id": "suspend",
            "label": "Suspend",
            "icon": "PauseCircleOutline",
            "type": "api-call",
            "url": "/apps/integriq/api/lti/lti_platform/@objectId/suspend",
            "method": "POST",
            "confirm": true,
            "variant": "error",
            "confirmTitle": "Suspend this platform",
            "confirmMessage": "Suspending this platform stops every launch from its LMS. Learners who start from that LMS are refused until the platform is approved again.",
            "confirmLabel": "Suspend",
            "successMessage": "The platform is suspended.",
            "visibleWhen": {
              "field": "status",
              "op": "eq",
              "value": "approved"
            }
          },
          {
            "id": "generate-key",
            "label": "Generate signing key",
            "icon": "KeyPlus",
            "type": "api-call",
            "url": "/apps/integriq/api/lti/lti_platform/@objectId/keys/generate",
            "method": "POST",
            "successMessage": "A signing key was generated."
          },
          {
            "id": "rotate-key",
            "label": "Rotate signing key",
            "icon": "KeyChange",
            "type": "api-call",
            "url": "/apps/integriq/api/lti/lti_platform/@objectId/keys/rotate",
            "method": "POST",
            "confirm": true,
            "variant": "error",
            "confirmTitle": "Rotate the signing key",
            "confirmMessage": "Rotating the key replaces the key the LMS holds for this platform. Launches signed with the old key are refused once the LMS has fetched the new one from the key set; give the LMS the new key before you continue.",
            "confirmLabel": "Rotate key",
            "successMessage": "The signing key was rotated."
          }
        ],
        "_note": "The four lifecycle actions (lti#approve, lti#suspend, lti#generateKey, lti#rotateKey) sit on the record they act on: row actions on the index, header actions on the detail. Suspend and rotate key confirm and name what they cut off (proposal, Answers 1); approve and generate key run at once. No errorMessage is set, so a refusal shows the server's own reason (for example 'already has an active signing key; use rotate instead'). signingKeys is write-only (register.d/99-lti-*-secrets-writeonly.json) and written only by the key actions, so the edit form leaves it out and never reads or sends a stored key; status changes only through approve and suspend.",
        "documentationUrl": "https://integriq.conduction.nl"
      }
    },
