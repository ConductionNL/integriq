{
  "$comment": "ADR-037 manifest fragment (automation-integration-regression-tests). An index page over integration_test_case, where an integration engineer adds, edits and deletes cases, and a logs page over integration_test_run with the counts each run stored. The run itself starts from POST /api/regression-suites/{subjectType}/{subjectId}/run; the buttons on the mapping and synchronization detail pages are tasks 4 and 5 of the change.",
  "pages": [
    {
      "id": "TestCases",
      "route": "/test-cases",
      "type": "index",
      "title": "Test cases",
      "permission": "admin",
      "config": {
        "register": "integriq",
        "schema": "integration_test_case",
        "columns": ["name", "subjectType", "subjectId", "description"],
        "sidebar": {
          "enabled": true,
          "showMetadata": true
        },
        "showViewAction": false,
        "showEditAction": true,
        "documentationUrl": "https://integriq.conduction.nl"
      }
    },
    {
      "id": "TestRuns",
      "route": "/test-runs",
      "type": "logs",
      "title": "Test runs",
      "permission": "admin",
      "config": {
        "register": "integriq",
        "schema": "integration_test_run",
        "sortKey": "startedAt",
        "sortOrder": "desc",
        "pagination": {
          "limit": 50
        },
        "rowDetail": true,
        "fixedLayout": true,
        "columns": [
          {
            "key": "startedAt",
            "label": "Started",
            "sortable": true,
            "width": "20%",
            "formatter": "datetime"
          },
          {
            "key": "subjectType",
            "label": "Subject type",
            "sortable": true,
            "width": "16%"
          },
          {
            "key": "subjectId",
            "label": "Subject",
            "sortable": true,
            "width": "28%"
          },
          {
            "key": "passed",
            "label": "Passed",
            "sortable": true,
            "width": "12%"
          },
          {
            "key": "failed",
            "label": "Failed",
            "sortable": true,
            "width": "12%"
          },
          {
            "key": "total",
            "label": "Total",
            "sortable": true,
            "width": "12%"
          }
        ]
      }
    }
  ],
  "menu": [
    {
      "id": "AutomationGroup",
      "children": [
        {
          "id": "TestCases",
          "label": "Test cases",
          "icon": "CheckCircleOutline",
          "route": "TestCases",
          "order": 50
        },
        {
          "id": "TestRuns",
          "label": "Test runs",
          "icon": "History",
          "route": "TestRuns",
          "order": 60
        }
      ]
    }
  ]
}
