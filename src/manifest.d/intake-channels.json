{
  "$comment": "ADR-037 manifest fragment (intake-channels-beyond-mail). The held message is the whole point of the design: a message that matches no rule is neither dropped nor turned into a default case, it waits for a human. Without this page nobody is that human. Columns are declared schema properties; the status colours map the schema's own enum members, so a value the schema cannot hold gets no colour rather than a wrong one. The rules page beside it is what makes routing configuration rather than a release.",
  "pages": [
    {
      "id": "IntakeMessages",
      "route": "/messages/intake",
      "type": "logs",
      "title": "Intake inbox",
      "config": {
        "register": "integriq",
        "schema": "intake_message",
        "sortKey": "receivedAt",
        "sortOrder": "desc",
        "pagination": {
          "limit": 50
        },
        "rowDetail": true,
        "fixedLayout": true,
        "columns": [
          {
            "key": "receivedAt",
            "label": "Received",
            "sortable": true,
            "width": "15%",
            "formatter": "datetime"
          },
          {
            "key": "channelId",
            "label": "Channel",
            "sortable": true,
            "width": "15%"
          },
          {
            "key": "text",
            "label": "Message",
            "sortable": false,
            "width": "25%"
          },
          {
            "key": "ruleName",
            "label": "Rule",
            "sortable": true,
            "width": "15%"
          },
          {
            "key": "reason",
            "label": "Reason",
            "sortable": false,
            "width": "18%"
          },
          {
            "key": "status",
            "label": "Status",
            "sortable": true,
            "width": "12%",
            "widget": "badge",
            "widgetProps": {
              "variant": "default",
              "colorMap": {
                "received": "info",
                "routed": "success",
                "held": "warning",
                "failed": "error",
                "rejected": "error"
              }
            }
          }
        ]
      },
      "actionsComponent": "IntakeMessageActions",
      "slots": {
        "row-actions": "IntakeMessageRowActions"
      }
    },
    {
      "id": "IntakeRoutingRules",
      "route": "/intake/routing-rules",
      "type": "index",
      "title": "Intake routing",
      "_note": "An editor, not a log (messaging-intake-routing-rules D1). Create and Edit open IntakeRuleEditorModal through slots['form-dialog'], which saves through POST/PUT /api/intake/routing-rules so validateRule() refuses a channel no adapter answers to and a mapping onto a field the case type lacks; CnFormDialog never mounts, and it could not reach `condition` or `fieldMapping` (type: object) anyway. Move up, Move down, Enable and Disable are handlers that write through the same endpoint. Delete is the built-in action on OpenRegister's objects endpoint, which the lockdown fragment allows for administrators. Copy is off: a copy written through the objects endpoint would skip that validation.",
      "config": {
        "register": "integriq",
        "schema": "intake_routing_rule",
        "sortKey": "order",
        "sortOrder": "asc",
        "columns": [
          "order",
          "name",
          "channelId",
          "targetSchema",
          "isEnabled"
        ],
        "sidebar": {
          "enabled": true,
          "showMetadata": true
        },
        "showViewAction": false,
        "showEditAction": true,
        "showCopyAction": false,
        "actions": [
          {
            "id": "move-up",
            "label": "Move up",
            "icon": "ArrowUp",
            "handler": "moveIntakeRuleUpHandler"
          },
          {
            "id": "move-down",
            "label": "Move down",
            "icon": "ArrowDown",
            "handler": "moveIntakeRuleDownHandler"
          },
          {
            "id": "disable",
            "label": "Disable",
            "icon": "ToggleSwitchOffOutline",
            "handler": "toggleIntakeRuleHandler",
            "visibleWhen": {
              "field": "isEnabled",
              "op": "neq",
              "value": false
            }
          },
          {
            "id": "enable",
            "label": "Enable",
            "icon": "ToggleSwitchOutline",
            "handler": "toggleIntakeRuleHandler",
            "visibleWhen": {
              "field": "isEnabled",
              "op": "eq",
              "value": false
            }
          }
        ]
      },
      "slots": {
        "form-dialog": "IntakeRuleEditorModal"
      }
    }
  ],
  "menu": [
    {
      "id": "ConnectionsGroup",
      "children": [
        {
          "id": "IntakeMessages",
          "label": "Intake inbox",
          "icon": "InboxArrowDown",
          "route": "IntakeMessages",
          "order": 45
        },
        {
          "id": "IntakeRoutingRules",
          "label": "Intake routing",
          "icon": "SignDirection",
          "route": "IntakeRoutingRules",
          "order": 46
        }
      ]
    }
  ]
}
