{
  "$schema": "https://raw.githubusercontent.com/ConductionNL/nextcloud-vue/main/src/schemas/app-manifest-v2.schema.json",
  "version": "2.0.1",
  "dependencies": [
    "openregister"
  ],
  "observability": {
    "_note": "OpenConnector adopts the OpenRegister AppHost observability engine (ADR-040). These descriptors reproduce the output of the now-deleted hand-written HealthController + MetricsController. The /api/health and /api/metrics routes are aliased to AppHost\\Controller\\GenericHealth#index / GenericMetrics#index (registered in lib/AppInfo/Application.php with appName=openconnector), so the engine reads this block at request time. Parity: metric names, types and label keys match the pre-adoption contract. Intentional improvements: /api/health is now #[PublicPage] and returns 503 on a failed database check (ADR-006); the bespoke `sources_table` OR-join probe is subsumed by the generic `openregister` availability check (degraded). All 9 counted descriptors are tableCount over chain-C legacy openconnector_* tables; on a drained instance every tableCount emits zero samples (never a 500). The post-cutover flip to objectCount is a one-line per-descriptor manifest edit.",
    "health": {
      "statusCodePolicy": "adr006",
      "checks": [
        {
          "id": "database",
          "type": "database",
          "severity": "critical"
        },
        {
          "id": "openregister",
          "type": "orAvailable",
          "severity": "degraded"
        }
      ]
    },
    "metrics": [
      {
        "name": "sources_total",
        "type": "gauge",
        "help": "Total sources by type",
        "source": {
          "kind": "tableCount",
          "table": "openconnector_sources",
          "groupBy": [
            "type"
          ],
          "labelDefaults": {
            "type": "rest"
          }
        }
      },
      {
        "name": "calls_total",
        "type": "counter",
        "help": "Total API calls by status and direction (inbound consumer throttling vs outbound source backoff)",
        "source": {
          "kind": "tableCount",
          "table": "openconnector_call_logs",
          "groupBy": [
            "status_code",
            "direction"
          ],
          "labelMap": {
            "status_code": "status"
          },
          "labelDefaults": {
            "status_code": "unknown",
            "direction": "outbound"
          }
        }
      },
      {
        "name": "synchronizations_total",
        "type": "gauge",
        "help": "Total synchronization runs",
        "source": {
          "kind": "tableCount",
          "table": "openconnector_synchronizations"
        }
      },
      {
        "name": "synchronization_runs_total",
        "type": "counter",
        "help": "Total synchronization log entries by result",
        "source": {
          "kind": "tableCount",
          "table": "openconnector_synchronization_logs",
          "groupBy": [
            "result"
          ],
          "labelMap": {
            "result": "status"
          },
          "labelDefaults": {
            "result": "unknown"
          }
        }
      },
      {
        "name": "endpoints_total",
        "type": "gauge",
        "help": "Total registered endpoints",
        "source": {
          "kind": "tableCount",
          "table": "openconnector_endpoints"
        }
      },
      {
        "name": "jobs_total",
        "type": "gauge",
        "help": "Total configured jobs",
        "source": {
          "kind": "tableCount",
          "table": "openconnector_jobs"
        }
      },
      {
        "name": "job_runs_total",
        "type": "counter",
        "help": "Total job log entries by status",
        "source": {
          "kind": "tableCount",
          "table": "openconnector_job_logs",
          "groupBy": [
            "status"
          ],
          "labelDefaults": {
            "status": "unknown"
          }
        }
      },
      {
        "name": "mappings_total",
        "type": "gauge",
        "help": "Total configured mappings",
        "source": {
          "kind": "tableCount",
          "table": "openconnector_mappings"
        }
      },
      {
        "name": "rules_total",
        "type": "gauge",
        "help": "Total configured rules",
        "source": {
          "kind": "tableCount",
          "table": "openconnector_rules"
        }
      },
      {
        "name": "circuit_breaker_state",
        "type": "gauge",
        "help": "Per-source circuit breaker state (1=open, 0=closed) — provider escape hatch (REQ-PROM-011, retry-and-circuit-breaker-policies): needs each Source's own field value, not a row count.",
        "source": {
          "kind": "provider"
        }
      }
    ]
  },
  "menu": [
    {
      "id": "Dashboard",
      "label": "Dashboard",
      "icon": "icon-category-dashboard",
      "route": "Dashboard",
      "order": 10
    },
    {
      "id": "Catalog",
      "label": "Catalog",
      "icon": "ViewGridOutline",
      "route": "Catalog",
      "order": 15
    },
    {
      "id": "ConnectionsGroup",
      "label": "Connections",
      "icon": "Webhook",
      "order": 20,
      "children": [
        { "id": "Sources", "label": "Sources", "icon": "DatabaseArrowLeftOutline", "route": "Sources", "order": 20 },
        { "id": "Endpoints", "label": "Endpoints", "icon": "Api", "route": "Endpoints", "order": 30 },
        { "id": "Consumers", "label": "Consumers", "icon": "AccountMultipleOutline", "route": "Consumers", "order": 40 },
        { "id": "Webhooks", "label": "Webhooks", "icon": "Webhook", "route": "Webhooks", "order": 50 },
        { "id": "NotificatiesAbonnementen", "label": "Abonnementen", "icon": "BellRingOutline", "route": "NotificatiesAbonnementen", "order": 55 }
      ]
    },
    {
      "id": "AutomationGroup",
      "label": "Automation",
      "icon": "VectorPolylinePlus",
      "order": 30,
      "children": [
        { "id": "Jobs", "label": "Jobs", "icon": "Update", "route": "Jobs", "order": 60 },
        { "id": "Mappings", "label": "Mappings", "icon": "SitemapOutline", "route": "Mappings", "order": 70 },
        { "id": "Rules", "label": "Rules", "icon": "ScaleBalance", "route": "Rules", "order": 80 },
        { "id": "Synchronizations", "label": "Synchronizations", "icon": "VectorPolylinePlus", "route": "Synchronizations", "order": 90 },
        { "id": "CloudEvents", "label": "Cloud events", "icon": "CloudUploadOutline", "route": "CloudEvents", "order": 100 },
        { "id": "EventDeliveries", "label": "Event deliveries", "icon": "EmailAlertOutline", "route": "EventDeliveries", "order": 110 },
        { "id": "Approvals", "label": "Approvals", "icon": "CheckboxMarkedCircleOutline", "route": "Approvals", "order": 120 },
        { "id": "SyncDeadLetters", "label": "Sync dead letters", "icon": "EmailAlertOutline", "route": "SyncDeadLetters", "order": 121 }
      ]
    },
    {
      "id": "Documentation",
      "label": "Documentation",
      "icon": "BookOpenVariant",
      "href": "https://openconnector.conduction.nl",
      "section": "footer",
      "order": 15
    },
    {
      "id": "Settings",
      "label": "Settings",
      "icon": "Cog",
      "route": "AppSettings",
      "order": 20
    },
    {
      "id": "FeaturesRoadmapMenu",
      "label": "Features & roadmap",
      "icon": "icon-toggle",
      "route": "FeaturesRoadmap",
      "section": "footer",
      "order": 16
    }
  ],
  "pages": [
    {
      "id": "FeaturesRoadmap",
      "route": "/features-roadmap",
      "type": "roadmap",
      "title": "Features & roadmap",
      "config": {
        "documentationUrl": "https://openconnector.conduction.nl"
      }
    },
    {
      "id": "Dashboard",
      "route": "/",
      "type": "dashboard",
      "title": "Dashboard",
      "config": {
        "dateRange": { "enabled": true, "showHeaderPicker": false, "persistKey": "openconnector-dashboard" },
        "widgets": [
          { "id": "kpi-sources",          "title": "Sources",          "type": "stats-block", "props": { "route": { "name": "Sources" } },                  "dataSource": { "register": "openconnector", "schema": "source",                   "aggregate": "count" } },
          { "id": "kpi-mappings",         "title": "Mappings",         "type": "stats-block", "props": { "route": { "name": "Mappings" } },                 "dataSource": { "register": "openconnector", "schema": "mapping",                  "aggregate": "count" } },
          { "id": "kpi-synchronizations", "title": "Synchronizations", "type": "stats-block", "props": { "route": { "name": "Synchronizations" } },         "dataSource": { "register": "openconnector", "schema": "synchronization",          "aggregate": "count" } },
          { "id": "kpi-contracts",        "title": "Contracts",        "type": "stats-block", "props": { "route": { "name": "SynchronizationContracts" } }, "dataSource": { "register": "openconnector", "schema": "synchronization_contract", "aggregate": "count" } },
          { "id": "kpi-jobs",             "title": "Jobs",             "type": "stats-block", "props": { "route": { "name": "Jobs" } },                     "dataSource": { "register": "openconnector", "schema": "job",                      "aggregate": "count" } },
          { "id": "kpi-endpoints",        "title": "Endpoints",        "type": "stats-block", "props": { "route": { "name": "Endpoints" } },                "dataSource": { "register": "openconnector", "schema": "endpoint",                 "aggregate": "count" } },

          { "id": "calls-daily",  "title": "Outgoing calls — daily",        "type": "chart", "props": { "chartKind": "area" }, "dataSource": { "register": "openconnector", "schema": "call_log",         "bucket": { "field": "created", "interval": "day",  "fromVar": "from", "toVar": "to" } } },
          { "id": "calls-hourly", "title": "Outgoing calls — by hour",      "type": "chart", "props": { "chartKind": "bar"  }, "dataSource": { "register": "openconnector", "schema": "call_log",         "bucket": { "field": "created", "interval": "hour", "fromVar": "from", "toVar": "to" } } },
          { "id": "jobs-daily",   "title": "Job executions — daily",        "type": "chart", "props": { "chartKind": "area" }, "dataSource": { "register": "openconnector", "schema": "job_log",          "bucket": { "field": "created", "interval": "day",  "fromVar": "from", "toVar": "to" } } },
          { "id": "jobs-hourly",  "title": "Job executions — by hour",      "type": "chart", "props": { "chartKind": "bar"  }, "dataSource": { "register": "openconnector", "schema": "job_log",          "bucket": { "field": "created", "interval": "hour", "fromVar": "from", "toVar": "to" } } },
          { "id": "sync-daily",   "title": "Synchronization runs — daily",  "type": "chart", "props": { "chartKind": "area" }, "dataSource": { "register": "openconnector", "schema": "synchronization_log", "bucket": { "field": "created", "interval": "day",  "fromVar": "from", "toVar": "to" } } },
          { "id": "sync-hourly",  "title": "Synchronization runs — by hour","type": "chart", "props": { "chartKind": "bar"  }, "dataSource": { "register": "openconnector", "schema": "synchronization_log", "bucket": { "field": "created", "interval": "hour", "fromVar": "from", "toVar": "to" } } }
        ],
        "layout": [
          { "id": "L1",  "widgetId": "kpi-sources",          "gridX": 0,  "gridY": 0,  "gridWidth": 2, "gridHeight": 2 },
          { "id": "L2",  "widgetId": "kpi-mappings",         "gridX": 2,  "gridY": 0,  "gridWidth": 2, "gridHeight": 2 },
          { "id": "L3",  "widgetId": "kpi-synchronizations", "gridX": 4,  "gridY": 0,  "gridWidth": 2, "gridHeight": 2 },
          { "id": "L4",  "widgetId": "kpi-contracts",        "gridX": 6,  "gridY": 0,  "gridWidth": 2, "gridHeight": 2 },
          { "id": "L5",  "widgetId": "kpi-jobs",             "gridX": 8,  "gridY": 0,  "gridWidth": 2, "gridHeight": 2 },
          { "id": "L6",  "widgetId": "kpi-endpoints",        "gridX": 10, "gridY": 0,  "gridWidth": 2, "gridHeight": 2 },

          { "id": "L7",  "widgetId": "calls-daily",          "gridX": 0,  "gridY": 2,  "gridWidth": 6, "gridHeight": 4 },
          { "id": "L8",  "widgetId": "calls-hourly",         "gridX": 6,  "gridY": 2,  "gridWidth": 6, "gridHeight": 4 },
          { "id": "L9",  "widgetId": "jobs-daily",           "gridX": 0,  "gridY": 6,  "gridWidth": 6, "gridHeight": 4 },
          { "id": "L10", "widgetId": "jobs-hourly",          "gridX": 6,  "gridY": 6,  "gridWidth": 6, "gridHeight": 4 },
          { "id": "L11", "widgetId": "sync-daily",           "gridX": 0,  "gridY": 10, "gridWidth": 6, "gridHeight": 4 },
          { "id": "L12", "widgetId": "sync-hourly",          "gridX": 6,  "gridY": 10, "gridWidth": 6, "gridHeight": 4 }
        ],
        "documentationUrl": "https://openconnector.conduction.nl"
      }
    },
    {
      "id": "Sources",
      "route": "/sources",
      "type": "index",
      "title": "Sources",
      "config": {
        "register": "openconnector",
        "schema": "source",
        "columns": ["name", "type", "status", "isEnabled", "lastSync", "dateModified"],
        "includeFields": ["name", "description", "type", "isEnabled", "auth", "authorizationHeader", "authenticationConfig", "apikey", "secret", "username", "password", "jwt", "jwtId", "configuration"],
        "sidebar": { "enabled": true, "showMetadata": true },
        "headerActions": [
          { "id": "view-logs", "label": "View logs", "icon": "TextBoxOutline", "type": "open-page", "target": "SourceLogs" }
        ],
        "showViewAction": false,
        "actions": [
          { "id": "view", "label": "View", "icon": "EyeOutline", "handler": "navigate", "route": "SourceDetail" },
          { "id": "test", "label": "Test connection", "icon": "icon-checkmark", "handler": "testSourceHandler" },
          { "id": "view-source-logs", "label": "View logs", "icon": "TextBoxOutline", "handler": "viewLogsHandler" }
        ],
        "documentationUrl": "https://openconnector.conduction.nl"
      },
      "slots": {
        "form-fields": "SourceFormFields"
      }
    },
    {
      "id": "SourceDetail",
      "route": "/sources/:id",
      "type": "detail",
      "title": "Source",
      "config": {
        "register": "openconnector",
        "schema": "source",
        "_note": "PURPOSE: A source is an external system OpenConnector calls (REST/SOAP/DB/file). This is the CONFIG/TECHNICAL archetype — an integrator lands here to check whether the connection is healthy and to triage failed calls, not to read documents. DESIGN RATIONALE: the body leads with operational data. Four KPI stats across the top (total calls, errors, avg size, objects fetched) give an at-a-glance health read; the primary body region is a recent-call-log table (child call_log filtered by source UUID = @objectId, sorted newest-first) because triaging HTTP failures is the #1 job on this page. Connection config (data, 3 columns to fit the many auth/rate-limit fields) and Related sit below/beside. NO comms leaves — a source does not email or hold meetings; the schema declares no email/calendar linkedType. Rarely-opened raw JSON blobs (paths/headers/loggingConfig) stay in the sidebar metadata, and audit-trail is a sidebar tab. ADR-062 rev3: the four health KPIs (calls, errors, objects fetched, avg payload) live in ONE in-grid stats-block top-right of the Connection core-data widget — entries[] carries per-entry metric/field so the sum (objectCount) and avg (size, raw bytes via countLabel) are expressible alongside the two counts. Registry icons; call log is read-only (allowCreate:false) with a View-all to SourceLogs.",
        "widgets": [
          { "id": "src-kpis-calls", "type": "stats-block", "icon": "Gauge", "title": "Calls", "content": { "entries": [
            { "title": "Calls", "countLabel": "logged", "register": "openconnector", "schema": "call_log", "metric": "count", "filter": { "source": "@objectId" }, "route": { "name": "SourceLogs", "query": { "source": "@objectId" } } }
          ] } },
          { "id": "src-kpis-errors", "type": "stats-block", "icon": "Gauge", "title": "Errors", "content": { "entries": [
            { "title": "Errors", "countLabel": ">=400", "variant": "error", "register": "openconnector", "schema": "call_log", "metric": "count", "filter": { "source": "@objectId", "statusCode": ">=400" }, "route": { "name": "SourceLogs", "query": { "source": "@objectId" } } }
          ] } },
          { "id": "src-kpis-objects", "type": "stats-block", "icon": "Gauge", "title": "Objects", "content": { "entries": [
            { "title": "Objects", "countLabel": "fetched", "register": "openconnector", "schema": "source", "metric": "sum", "field": "objectCount", "filter": { "id": "@objectId" } }
          ] } },
          { "id": "src-kpis-payload", "type": "stats-block", "icon": "Gauge", "title": "Payload", "content": { "entries": [
            { "title": "Payload", "countLabel": "bytes (avg)", "register": "openconnector", "schema": "call_log", "metric": "avg", "field": "size", "filter": { "source": "@objectId" } }
          ] } },
          { "id": "src-calls",   "type": "object-list", "icon": "Timeline", "title": "Recent calls", "content": { "register": "openconnector", "schema": "call_log", "filter": { "source": "@objectId" }, "sort": { "created": "desc" }, "columns": [ { "key": "created", "label": "When" }, { "key": "statusCode", "label": "Status" }, { "key": "statusMessage", "label": "Message" }, { "key": "size", "label": "Size" } ], "limit": 25, "allowCreate": false, "rowRoute": "SourceLogs", "viewAllRoute": "SourceLogs", "viewAllQuery": { "source": "@objectId" }, "emptyText": "No calls logged for this source yet." } },
          { "id": "src-data",    "type": "data", "icon": "DatabaseOutline", "title": "Connection", "content": { "columns": 3 } },
          { "id": "src-related", "type": "related", "icon": "LinkVariant", "title": "Used by" }
        ],
        "layout": [
          { "id": "1", "widgetId": "src-data",    "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 6 },
          { "id": "2a", "widgetId": "src-kpis-calls",   "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 2 },
          { "id": "2b", "widgetId": "src-kpis-errors",  "gridX": 8, "gridY": 2, "gridWidth": 4, "gridHeight": 2 },
          { "id": "2c", "widgetId": "src-kpis-objects", "gridX": 8, "gridY": 4, "gridWidth": 4, "gridHeight": 2 },
          { "id": "2d", "widgetId": "src-kpis-payload", "gridX": 8, "gridY": 6, "gridWidth": 4, "gridHeight": 2 },
          { "id": "3", "widgetId": "src-calls",   "gridX": 0, "gridY": 8, "gridWidth": 8, "gridHeight": 6 },
          { "id": "4", "widgetId": "src-related", "gridX": 8, "gridY": 8, "gridWidth": 4, "gridHeight": 6 }
        ],
        "bodyWidgets": [
          { "id": "src-circuit-breaker", "component": "CircuitBreakerBadge", "title": "Circuit breaker", "placement": "before-body", "colSpan": 12 }
        ],
        "sidebar": {
          "enabled": true,
          "showMetadata": true,
          "tabs": [
            { "id": "audit", "label": "Audit trail", "icon": "History", "widgets": [ { "type": "audit" } ] }
          ]
        },
        "documentationUrl": "https://openconnector.conduction.nl"
      }
    },
    {
      "id": "SourceLogs",
      "route": "/sources/logs",
      "type": "logs",
      "title": "Source logs",
      "config": {
        "register": "openconnector",
        "schema": "call_log"
      }
    },
    {
      "id": "Endpoints",
      "route": "/endpoints",
      "type": "index",
      "title": "Endpoints",
      "config": {
        "register": "openconnector",
        "schema": "endpoint",
        "columns": ["name", "method", "endpoint", "targetType", "updated"],
        "includeFields": ["name", "description", "endpoint", "method", "targetType"],
        "sidebar": { "enabled": true, "showMetadata": true },
        "headerActions": [
          { "id": "view-logs", "label": "View logs", "icon": "TextBoxOutline", "type": "open-page", "target": "EndpointLogs" }
        ],
        "showViewAction": false,
        "actions": [
          { "id": "view", "label": "View", "icon": "EyeOutline", "handler": "navigate", "route": "EndpointDetail" },
          { "id": "add-rule", "label": "Add rule", "icon": "icon-add", "handler": "addEndpointRuleHandler" },
          { "id": "view-endpoint-logs", "label": "View logs", "icon": "TextBoxOutline", "handler": "viewLogsHandler" }
        ],
        "documentationUrl": "https://openconnector.conduction.nl"
      }
    },
    {
      "id": "EndpointDetail",
      "route": "/endpoints/:id",
      "type": "detail",
      "title": "Endpoint",
      "config": {
        "register": "openconnector",
        "schema": "endpoint",
        "_note": "PURPOSE: An endpoint is an inbound route OpenConnector exposes (path + HTTP method) that maps requests onto a target (register/schema/source/job) via input/output mappings and attached rules. CONFIG/TECHNICAL archetype. DESIGN RATIONALE: unlike a source, an endpoint has NO child log table with an endpoint foreign key (call_log keys on source/synchronization, not endpoint), so there is no runs list to surface — the operational payload IS the routing configuration. The body therefore leads with a wide config panel (data, 2 columns) exposing path/regex, method, targetType/targetId and the input/output mapping references, with a Related panel beside it so the integrator can jump to the mappings and target this endpoint wires together. NO comms leaves — an endpoint routes HTTP, it does not communicate; the schema declares no email/calendar linkedType. The verbose conditions[]/rules[]/endpointArray JSON stays reachable in sidebar metadata; audit-trail is a sidebar tab.",
        "widgets": [
          { "id": "ep-data",    "type": "data", "icon": "SourceBranch", "title": "Route & mapping", "content": { "columns": 2 } },
          { "id": "ep-related", "type": "related", "icon": "LinkVariant", "title": "Wired to" }
        ],
        "layout": [
          { "id": "1", "widgetId": "ep-data",    "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 7 },
          { "id": "2", "widgetId": "ep-related", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 7 }
        ],
        "sidebar": {
          "enabled": true,
          "showMetadata": true,
          "tabs": [
            { "id": "audit", "label": "Audit trail", "icon": "History", "widgets": [ { "type": "audit" } ] }
          ]
        },
        "documentationUrl": "https://openconnector.conduction.nl"
      }
    },
    {
      "id": "EndpointLogs",
      "route": "/endpoints/logs",
      "type": "logs",
      "title": "Endpoint logs",
      "config": {
        "register": "openconnector",
        "schema": "call_log"
      }
    },
    {
      "id": "Consumers",
      "route": "/consumers",
      "type": "index",
      "title": "Consumers",
      "config": {
        "register": "openconnector",
        "schema": "consumer",
        "columns": ["name", "authorizationType", "domains", "updated"],
        "includeFields": ["name", "description", "authorizationType"],
        "sidebar": { "enabled": true, "showMetadata": true },
        "showViewAction": false,
        "actions": [
          { "id": "view", "label": "View", "icon": "EyeOutline", "handler": "navigate", "route": "ConsumerDetail" }
        ],
        "documentationUrl": "https://openconnector.conduction.nl"
      }
    },
    {
      "id": "ConsumerDetail",
      "route": "/consumers/:id",
      "type": "detail",
      "title": "Consumer",
      "config": {
        "register": "openconnector",
        "schema": "consumer",
        "_note": "PURPOSE: A consumer is an external client authorised to call OpenConnector (auth type + allowed domains/IPs). CONFIG/TECHNICAL archetype. DESIGN RATIONALE: the two things an admin does here are (1) confirm the access policy and (2) see what this consumer has actually been sent. The body pairs a compact access-config panel (data, 2 columns: authorizationType, domains, ips) with a Related panel, then leads the lower body with an event-delivery table — event_message rows filtered by the consumer UUID (@objectId), newest-first, showing status/retries/last-attempt — because delivery health is the operational signal for a subscribed consumer. Two KPI stats (deliveries, failed) sit up top. NO comms leaves — a consumer is a machine client, not a person; the schema declares no email/calendar linkedType. Audit-trail is a sidebar tab. ADR-062 rev3: deliveries+failed are ONE in-grid stats-block (entries[]) top-right of the access-policy core-data widget, each entry deep-linking into EventDeliveries filtered on this consumer. event_message list is read-only (allowCreate:false) with a View-all to EventDeliveries; registry icons.",
        "widgets": [
          { "id": "con-kpis-deliveries", "type": "stats-block", "icon": "Gauge", "title": "Deliveries", "content": { "entries": [
