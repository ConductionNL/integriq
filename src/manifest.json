    {
      "id": "CloudEventDetail",
      "route": "/cloud-events/events/:id",
      "type": "detail",
      "title": "Cloud event",
      "config": {
        "register": "openconnector",
        "schema": "event",
        "_note": "PURPOSE: A CloudEvent is an immutable event record (CloudEvents 1.0 envelope: source/type/subject/specversion + a data payload) that fans out to subscribed consumers. CONFIG/TECHNICAL, read-only archetype — you inspect what happened and where it went, you do not edit it. DESIGN RATIONALE: the body leads with the CloudEvent envelope (data, 2 columns: source/type/subject/time/status) since that is the record itself, then the operational answer to 'was this delivered?' — an event_message table filtered by the event UUID (@objectId) showing each consumer delivery, status and retry count, newest-first. The `data` payload JSON is the second question, so it stays within the data widget (which renders the data field) and the object metadata rather than crowding the body; Related sits beside the envelope. NO comms leaves — a CloudEvent is a technical message record, not a person; the schema declares no email/calendar linkedType and no files are attached.",
        "widgets": [
          { "id": "evt-data",    "type": "data", "icon": "Bell", "title": "CloudEvent", "content": { "columns": 2 } },
          { "id": "evt-related", "type": "related", "icon": "LinkVariant", "title": "Related" },
          { "id": "evt-deliveries", "type": "object-list", "icon": "Email", "title": "Deliveries", "content": { "register": "openconnector", "schema": "event_message", "filter": { "event": "@objectId" }, "sort": { "created": "desc" }, "columns": [ { "key": "consumer", "label": "Consumer" }, { "key": "status", "label": "Status" }, { "key": "retryCount", "label": "Retries" }, { "key": "lastAttempt", "label": "Last attempt" } ], "limit": 25, "allowCreate": false, "rowRoute": "EventDeliveries", "viewAllRoute": "EventDeliveries", "viewAllQuery": { "event": "@objectId" }, "emptyText": "No deliveries recorded for this event yet." } }
        ],
        "layout": [
          { "id": "1", "widgetId": "evt-data",       "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 5 },
          { "id": "2", "widgetId": "evt-related",    "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 5 },
          { "id": "3", "widgetId": "evt-deliveries", "gridX": 0, "gridY": 5, "gridWidth": 12, "gridHeight": 6 }
        ],
        "sidebar": {
          "enabled": true,
          "showMetadata": true,
          "tabs": [
            { "id": "audit", "label": "Audit trail", "icon": "History", "widgets": [ { "type": "audit" } ] }
          ]
        },
        "documentationUrl": "https://openconnector.conduction.nl"
      }
    },
