{
  "info": {
    "name": "Integriq — Nextcloud event triggers (nextcloud-event-hub-verification)",
    "description": "nextcloud-event-hub-verification task 4, the subscription API. A subscription sent with `action` and `retryPolicy` round-trips through the subscribe answer, the stored object and the list; a non-admin whose group holds `event.subscribe` but no `event.subscribe-nextcloud-<family>` action is refused with 403 for each of the four families (Files, Calendar, Tables, Forms), while a type outside them passes; and the delivery status of a subscription's messages is readable. The member and group are created over OCS, the action matrix is read first and put back afterwards, and every fixture is removed again. Run with `tests/postman/integriq.postman_environment.json`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{admin_user}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{admin_password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "ocBase",
      "value": "{{base_url}}/index.php/apps/integriq/api"
    },
    {
      "key": "orBase",
      "value": "{{base_url}}/index.php/apps/openregister/api/objects/integriq"
    },
    {
      "key": "eventMemberPassword",
      "value": "Newman-Event-Member-2026!"
    }
  ],
