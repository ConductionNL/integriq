    {
      "name": "GET /admin/action-matrix — keep the matrix as it was",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{ocBase}}/admin/action-matrix",
          "host": [
            "{{ocBase}}"
          ],
          "path": [
            "admin",
            "action-matrix"
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('an administrator reads the action matrix', () => pm.response.to.have.status(200));",
              "const matrix = pm.response.json().matrix || {};",
              "pm.collectionVariables.set('fxSavedMatrix', JSON.stringify(matrix));"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT /admin/action-matrix — grant subscribing, but no event family",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{ocBase}}/admin/action-matrix",
          "host": [
            "{{ocBase}}"
          ],
          "path": [
            "admin",
            "action-matrix"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{fxGrantBody}}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const matrix = JSON.parse(pm.collectionVariables.get('fxSavedMatrix') || '{}');",
              "for (const action of ['event.subscribe', 'event.subscriptions', 'event.subscription-messages']) {",
              "    const groups = Array.isArray(matrix[action]) ? matrix[action] : ['admin'];",
              "    matrix[action] = Array.from(new Set([...groups, 'newman-event-subscribers']));",
              "}",
              "for (const family of ['files', 'calendar', 'tables', 'forms']) {",
              "    const action = 'event.subscribe-nextcloud-' + family;",
              "    const groups = Array.isArray(matrix[action]) ? matrix[action] : ['admin'];",
              "    matrix[action] = groups.filter(group => group !== 'newman-event-subscribers');",
              "}",
              "pm.collectionVariables.set('fxGrantBody', JSON.stringify({ matrix }));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the coarse subscribe actions are granted', () => pm.response.to.have.status(200));",
              "const stored = pm.response.json().matrix || {};",
              "pm.test('no Nextcloud event family is granted to the group', () => {",
              "    for (const family of ['files', 'calendar', 'tables', 'forms']) {",
              "        pm.expect(stored['event.subscribe-nextcloud-' + family] || ['admin']).to.not.include('newman-event-subscribers');",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
