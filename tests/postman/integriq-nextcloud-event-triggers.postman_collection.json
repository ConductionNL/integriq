    {
      "name": "POST /events/subscriptions — subscribe with action and retryPolicy",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{ocBase}}/events/subscriptions",
          "host": [
            "{{ocBase}}"
          ],
          "path": [
            "events",
            "subscriptions"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"newman-hub-files\", \"style\": \"push\", \"protocol\": \"HTTP\", \"sink\": \"https://example.org/newman-nextcloud-events\", \"types\": [\"com.nextcloud.files.node.created\"], \"action\": {\"kind\": \"webhook\", \"sink\": \"https://example.org/newman-nextcloud-events\"}, \"retryPolicy\": {\"baseSeconds\": 30, \"factor\": 2, \"capSeconds\": 600, \"maxRetries\": 3}}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "const uuid = b.uuid || b.id || (b['@self'] && b['@self'].id);",
              "pm.test('the subscription has an id', () => pm.expect(uuid).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('fxHubSubUuid', uuid);",
              "pm.test('the answer carries the action and the retry policy', () => {",
              "    pm.expect(b.action).to.eql({\"kind\": \"webhook\", \"sink\": \"https://example.org/newman-nextcloud-events\"});",
              "    pm.expect(b.retryPolicy).to.eql({\"baseSeconds\": 30, \"factor\": 2, \"capSeconds\": 600, \"maxRetries\": 3});",
              "});"
            ]
          }
        }
      ]
    },
