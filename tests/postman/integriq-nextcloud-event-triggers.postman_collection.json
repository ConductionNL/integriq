          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('the answer names the subscription and lists its messages', () => {",
              "    pm.expect(b.subscription).to.be.an('object');",
              "    pm.expect(b.messages).to.be.an('array');",
              "});",
              "pm.test('every message carries a delivery status of the lifecycle', () => {",
              "    for (const message of b.messages) {",
              "        const row = message.object || message;",
              "        pm.expect(['pending', 'delivered', 'failed', 'abandoned', 'discarded']).to.include(row.status);",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
