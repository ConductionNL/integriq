{
  "info": {
    "name": "Integriq — ORI public serving parity (ori-public-serving)",
    "description": "ori-public-serving task 2, the Newman half: TC-8, TC-9, TC-10 and TC-11 of openspec/changes/ori-public-serving/test-plan.md. Anonymous single-object reads on the ori-parity/v1 endpoints answer 404, never 403, for an amendment asked for as a motion (the endpoint's fixedFilters, REQ-EP-010), a draft meeting, and a publication dated in the future; each is compared with decidiq's own OriController, and the amendment is served under /amendments, so the guard is shown to be selective. TC-10 is the Risk 3 check: if the endpoint answers 200 where OriController answers 404, the publish-window gate needs its own filter. The objects are staged in decidiq's register through OpenRegister's objects API under this run's marker and deleted again. Precondition: decidiq is installed; without its register the first request stops the run. Run with tests/postman/integriq.postman_environment.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{admin_user}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{admin_password}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Precondition: decidiq's register is installed (otherwise the run stops here)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/index.php/apps/openregister/api/registers?_limit=500"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the registers list answers', () => pm.expect(pm.response.code).to.eql(200));",
              "const rows = (pm.response.json().results || []);",
              "const present = rows.some((r) => r.slug === 'decidiq');",
              "pm.collectionVariables.set('oriStamp', Date.now().toString(36));",
              "if (!present) {",
              "    console.log('decidiq is not installed on this instance: the ORI parity checks need its register and OriController, so the run stops.');",
              "    postman.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Stage: a public amendment (Decision with decisionType amendment)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/index.php/apps/openregister/api/objects/decidiq/decision",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Newman ORI amendment {{oriStamp}}\",\n  \"text\": \"Staged by tests/postman/ori-public-serving.postman_collection.json\",\n  \"decisionType\": \"amendment\",\n  \"isPublished\": \"public\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('staged through OpenRegister', () => pm.expect(pm.response.code, pm.response.text()).to.be.within(200, 299));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('oriAmendment', String(body.id || body.uuid || (body['@self'] || {}).id || ''));",
              "pm.test('the staged object has an id', () => pm.expect(pm.collectionVariables.get('oriAmendment')).to.not.eql(''));"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-8: the amendment is not served as a motion",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/ori-parity/v1/motions/{{oriAmendment}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('an amendment under /motions: 404, the same as an unknown id', () => pm.expect(pm.response.code).to.eql(404));",
              "pm.test('never 403: hidden and unknown look the same (TC-11)', () => pm.expect(pm.response.code).to.not.eql(403));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "TC-8 control: the same amendment is served under /amendments (the guard is selective, not vacuous)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/ori-parity/v1/amendments/{{oriAmendment}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('an amendment under /amendments answers 200', () => pm.expect(pm.response.code, pm.response.text()).to.eql(200));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "TC-8 parity: OriController hides it under /motions too",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/index.php/apps/decidiq/api/ori/v1/motions/{{oriAmendment}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('OriController answers 404 for an amendment under /motions', () => pm.expect(pm.response.code).to.eql(404));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "Stage: a draft meeting",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/index.php/apps/openregister/api/objects/decidiq/meeting",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Newman ORI draft meeting {{oriStamp}}\",\n  \"meetingType\": \"regular\",\n  \"scheduledDate\": \"2030-01-15T19:30:00+01:00\",\n  \"meetingMode\": \"in-person\",\n  \"lifecycle\": \"draft\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('staged through OpenRegister', () => pm.expect(pm.response.code, pm.response.text()).to.be.within(200, 299));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('oriDraftMeeting', String(body.id || body.uuid || (body['@self'] || {}).id || ''));",
              "pm.test('the staged object has an id', () => pm.expect(pm.collectionVariables.get('oriDraftMeeting')).to.not.eql(''));"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-9: a draft meeting is not served",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/ori-parity/v1/events/{{oriDraftMeeting}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('a draft meeting: 404, the same as an unknown id', () => pm.expect(pm.response.code).to.eql(404));",
              "pm.test('never 403: hidden and unknown look the same (TC-11)', () => pm.expect(pm.response.code).to.not.eql(403));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "TC-9 parity: OriController hides the draft meeting too",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/index.php/apps/decidiq/api/ori/v1/events/{{oriDraftMeeting}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('OriController answers 404 for a draft meeting', () => pm.expect(pm.response.code).to.eql(404));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "Stage: a publication dated in the future",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/index.php/apps/openregister/api/objects/decidiq/publication-payload",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"oriType\": \"Besluit\",\n  \"title\": \"Newman ORI future publication {{oriStamp}}\",\n  \"publicationDate\": \"2099-01-01T00:00:00+00:00\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('staged through OpenRegister', () => pm.expect(pm.response.code, pm.response.text()).to.be.within(200, 299));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('oriFuturePublication', String(body.id || body.uuid || (body['@self'] || {}).id || ''));",
              "pm.test('the staged object has an id', () => pm.expect(pm.collectionVariables.get('oriFuturePublication')).to.not.eql(''));"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-10 control: OriController hides the future publication",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/index.php/apps/decidiq/api/ori/v1/publications/{{oriFuturePublication}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('oriControlStatus', String(pm.response.code));",
              "pm.test('OriController answers 404 for a publication not yet live', () => pm.expect(pm.response.code).to.eql(404));"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "TC-10: the endpoint hides the future publication as OriController does (Risk 3)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/ori-parity/v1/publications/{{oriFuturePublication}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('a publication not yet live: 404, the same as an unknown id', () => pm.expect(pm.response.code).to.eql(404));",
              "pm.test('never 403: hidden and unknown look the same (TC-11)', () => pm.expect(pm.response.code).to.not.eql(403));",
              "pm.test('the endpoint answers what OriController answers', () => pm.expect(String(pm.response.code)).to.eql(pm.collectionVariables.get('oriControlStatus')));",
              "if (pm.response.code === 200 && pm.collectionVariables.get('oriControlStatus') === '404') {",
              "    console.log('Risk 3 does not hold: the publish-window gate needs its own fixed filter on the publications endpoint.');",
              "}"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "Teardown: delete the staged decision",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/index.php/apps/openregister/api/objects/decidiq/decision/{{oriAmendment}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('oriAmendment')) { pm.execution && pm.execution.skipRequest ? pm.execution.skipRequest() : null; }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('removed', () => pm.expect(pm.response.code).to.be.oneOf([200, 204, 404, 405]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Teardown: delete the staged meeting",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/index.php/apps/openregister/api/objects/decidiq/meeting/{{oriDraftMeeting}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('oriDraftMeeting')) { pm.execution && pm.execution.skipRequest ? pm.execution.skipRequest() : null; }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('removed', () => pm.expect(pm.response.code).to.be.oneOf([200, 204, 404, 405]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Teardown: delete the staged publication-payload",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "OCS-APIRequest",
            "value": "true"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/index.php/apps/openregister/api/objects/decidiq/publication-payload/{{oriFuturePublication}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('oriFuturePublication')) { pm.execution && pm.execution.skipRequest ? pm.execution.skipRequest() : null; }"
            ]
