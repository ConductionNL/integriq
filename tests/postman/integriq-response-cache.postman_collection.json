                "value": "true"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/integriq/api/endpoints/{{cacheEndpointUuid}}/cache/clear",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{admin_user}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{admin_password}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "After clearing, the next call reaches the source: MISS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('X-Cache: MISS', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/newman-cache-{{cacheRun}}",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "An upstream answer marked no-store: MISS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('X-Cache: MISS', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS'));",
                  "const cacheControl = ((pm.response.json().headers || {})['Cache-Control'] || []).join(',');",
                  "pm.test('The upstream said no-store', () => pm.expect(cacheControl).to.include('no-store'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/newman-no-store-{{cacheRun}}",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Asked again, a no-store answer is still not served from the cache",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('X-Cache: MISS, never HIT', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/newman-no-store-{{cacheRun}}",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2. Problem documents (REQ-RCPE-002)",
      "item": [
        {
          "name": "A wrong key: 401 problem document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "const problem = pm.response.json();",
                  "pm.test('application/problem+json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));",
                  "pm.test('The RFC 9457 members are there', () => {",
                  "  pm.expect(problem.type).to.be.a('string').and.match(/^(https?:|about:)/);",
                  "  pm.expect(problem.title).to.be.a('string').and.not.empty;",
                  "  pm.expect(problem.status).to.eql(pm.response.code);",
                  "  pm.expect(problem.detail).to.be.a('string').and.not.empty;",
                  "  pm.expect(problem.instance).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('The old error member is still there for one release', () => pm.expect(problem).to.have.property('error'));",
                  "pm.test('A type for authentication failures', () => pm.expect(problem.type).to.include('authentication-failed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "newman-wrong-key"
              }
            ],
            "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/newman-protected-{{cacheRun}}",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "The right key passes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "newman-right-key-{{cacheRun}}"
              }
            ],
            "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/newman-protected-{{cacheRun}}",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "A path no endpoint serves: 404 problem document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));",
                  "const problem = pm.response.json();",
                  "pm.test('application/problem+json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));",
                  "pm.test('The RFC 9457 members are there', () => {",
                  "  pm.expect(problem.type).to.be.a('string').and.match(/^(https?:|about:)/);",
                  "  pm.expect(problem.title).to.be.a('string').and.not.empty;",
                  "  pm.expect(problem.status).to.eql(pm.response.code);",
                  "  pm.expect(problem.detail).to.be.a('string').and.not.empty;",
                  "  pm.expect(problem.instance).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('The old error member is still there for one release', () => pm.expect(problem).to.have.property('error'));",
                  "pm.test('A type for not found', () => pm.expect(problem.type).to.include('not-found'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/newman-nothing-here-{{cacheRun}}",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
