    }
  ],
  "item": [
    {
      "name": "0. Setup (via OpenRegister)",
      "item": [
        {
          "name": "Create the source",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh paths and key per run, so a run never meets what an earlier run left behind.",
                  "const run = Date.now();",
                  "pm.collectionVariables.set('cacheEndpointPath', 'newman-cached-' + run);",
                  "pm.collectionVariables.set('problemEndpointPath', 'newman-protected-' + run);",
                  "pm.collectionVariables.set('problemKey', 'newman-problem-' + run);",
                  "// Unauthenticated calls go to another host alias, so the session cookie of the",
                  "// signed-in setup requests (host-scoped) is never sent with them. An environment",
                  "// value of noAuthBase wins over this one.",
                  "const base = pm.variables.get('base_url');",
                  "pm.collectionVariables.set('noAuthBase', base.includes('localhost') ? base.replace('localhost', '127.0.0.1') : base.replace('127.0.0.1', 'localhost'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Setup: source created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('cacheSourceUuid', body.id || (body['@self'] || {}).id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "OCS-APIRequest",
                "value": "true"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/openregister/api/objects/integriq/source",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{admin_user}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{admin_password}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"newman-cached-source\",\"type\":\"api\",\"location\":\"{{base_url}}\",\"isEnabled\":true,\"auth\":\"none\"}"
            }
          }
        },
