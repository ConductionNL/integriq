    {
      "name": "1. Response cache (REQ-RCPE-001)",
      "item": [
        {
          "name": "The first call reaches the source: MISS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('X-Cache: MISS', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS'));",
                  "pm.collectionVariables.set('firstBody', pm.response.text());"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/newman-cache-{{cacheRun}}",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "The same call within a minute is answered from the cache: HIT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('X-Cache: HIT', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('HIT'));",
                  "pm.test('The same answer', () => pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('firstBody')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/newman-cache-{{cacheRun}}",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "The source was called once and the call log marks the hit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json().results || pm.response.json();",
                  "const upstream = rows.filter((row) => row.direction === 'outbound' && row.cacheHit !== true);",
                  "const hits = rows.filter((row) => row.cacheHit === true);",
                  "pm.test('One call reached the source', () => pm.expect(upstream.length).to.eql(1));",
                  "pm.test('One hit is on the call log', () => pm.expect(hits.length).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "OCS-APIRequest",
                "value": "true"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/integriq/api/sources/logs?source={{cacheSourceUuid}}&_limit=50",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{admin_user}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{admin_password}}",
                  "type": "string"
                }
              ]
            }
          }
        },
