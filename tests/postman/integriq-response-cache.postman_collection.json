    {
      "name": "1. A busy lookup reaches the source once (REQ-RCPE-001)",
      "item": [
        {
          "name": "First call: from the source, X-Cache MISS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('REQ-RCPE-001: the first call is answered', () => pm.response.to.have.status(200));",
                  "pm.test('REQ-RCPE-001: the first answer carries X-Cache: MISS', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS'));",
                  "pm.collectionVariables.set('cacheFirstBody', pm.response.text());"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/{{cacheEndpointPath}}",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Second call within the minute: X-Cache HIT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const shared = pm.response.headers.get('X-Cache') === 'HIT';",
                  "pm.collectionVariables.set('cacheShared', shared ? 'true' : 'false');",
                  "if (shared === false) {",
                  "    console.log('Second call answered X-Cache ' + pm.response.headers.get('X-Cache') + ': this instance has no distributed cache to keep answers in. HIT checks skipped.');",
                  "}",
                  "pm.test('REQ-RCPE-001: the second call is answered', () => pm.response.to.have.status(200));",
                  "(shared ? pm.test : pm.test.skip)('REQ-RCPE-001: the second answer carries X-Cache: HIT', () => pm.expect(pm.response.headers.get('X-Cache')).to.eql('HIT'));",
                  "(shared ? pm.test : pm.test.skip)('REQ-RCPE-001: the cached answer is the first answer', () => pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('cacheFirstBody')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/{{cacheEndpointPath}}",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "The source was called once, and the hit is in the call log",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Call log readable', () => pm.response.to.have.status(200));",
                  "const entries = pm.response.json().results || [];",
                  "const sent = entries.filter(e => e.cacheHit !== true && e.direction === 'outbound');",
                  "const hits = entries.filter(e => e.cacheHit === true);",
                  "(pm.collectionVariables.get('cacheShared') === 'true' ? pm.test : pm.test.skip)('REQ-RCPE-001: the source was called once', () => pm.expect(sent.length).to.eql(1));",
                  "(pm.collectionVariables.get('cacheShared') === 'true' ? pm.test : pm.test.skip)('REQ-RCPE-001: the call log marks the hit', () => pm.expect(hits.length).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "OCS-APIRequest",
                "value": "true"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/openregister/api/objects/integriq/call_log?source={{cacheSourceUuid}}&_limit=50",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{admin_user}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{admin_password}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
