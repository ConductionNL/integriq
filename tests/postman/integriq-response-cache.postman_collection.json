    {
      "name": "3. Gateway errors are problem documents (REQ-RCPE-002)",
      "item": [
        {
          "name": "A wrong key: 401 problem document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('REQ-RCPE-002: a wrong key gets 401', () => pm.response.to.have.status(401));",
                  "pm.test('REQ-RCPE-002: the content type is application/problem+json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));",
                  "const body = pm.response.json();",
                  "pm.test('REQ-RCPE-002: the type URI names an authentication failure', () => pm.expect(body.type).to.match(/authentication/));",
                  "pm.test('REQ-RCPE-002: status and title are set', () => { pm.expect(body.status).to.eql(401); pm.expect(body.title).to.be.a('string').that.is.not.empty; });",
                  "pm.test('REQ-RCPE-002: the old error member is still present', () => pm.expect(body.error).to.be.a('string').that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "not-the-key"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/{{problemEndpointPath}}",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "The right key passes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('REQ-RCPE-002: the right key is not refused', () => pm.expect(pm.response.code).to.not.be.oneOf([401, 403]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{problemKey}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/{{problemEndpointPath}}",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "A path no endpoint serves: a problem document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('REQ-RCPE-002: an unknown path gets 404', () => pm.response.to.have.status(404));",
                  "pm.test('REQ-RCPE-002: the content type is application/problem+json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));",
                  "pm.test('REQ-RCPE-002: the old error member is still present', () => pm.expect(pm.response.json().error).to.be.a('string').that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/newman-no-such-endpoint-{{cacheEndpointPath}}",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
