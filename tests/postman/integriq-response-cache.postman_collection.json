          "request": {
            "method": "POST",
            "header": [
              {
                "key": "OCS-APIRequest",
                "value": "true"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/openregister/api/objects/integriq/endpoint",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{admin_user}}",
                  "type": "string"
                },
                {
