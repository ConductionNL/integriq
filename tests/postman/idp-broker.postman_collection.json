    {
      "name": "9. Teardown",
      "item": [
        {
          "name": "IB.90 delete the OIDC registration",
          "request": {
            "method": "DELETE",
            "url": "{{orBase}}/idpRegistration/{{idpOidcUuid}}",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('deleted', () => pm.expect([200, 204, 404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
