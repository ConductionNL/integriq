                "type": "text/javascript",
                "exec": [
                  "pm.test('not published: 404, or 429 once misses are throttled', () => pm.expect([404, 429]).to.include(pm.response.code));",
                  "pm.test('no document', () => pm.expect(pm.response.text()).to.not.match(/client_id|EntityDescriptor|\"keys\"/));"
                ]
              }
            }
          ]
