{
  "info": {
    "_postman_id": "integriq-idp-broker-2026-11-26",
    "name": "Integriq — identity-provider registrations (portal-idp-broker-config)",
    "description": "Newman test of task 12 of openspec/changes/portal-idp-broker-config: each organisation's SP/RP metadata is published at its own address (REQ-IDPC-003): an OIDC client 200, an unreadable SAML certificate 503 without naming the credential, a disabled or unknown registration 404. Only an administrator lists, tests, creates, reads or changes an idpRegistration (REQ-IDPC-008); a plain user and an anonymous caller are refused. Yivi is saved only as OIDC. Not here: the SAML and OIDC login round trips through stub identity providers. In this build every start and callback is refused before a live adapter is reached (see tests/e2e/idp-assurance-floor.spec.ts), so a round trip cannot pass until a live adapter is bound; that half of the task stays open.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{admin_user}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{admin_password}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Nextcloud's CSRF check refuses a basic-auth call that also carries the session cookie Newman keeps.",
          "pm.request.headers.upsert({ key: 'OCS-APIRequest', value: 'true' });",
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "ocBase",
      "value": "{{base_url}}/index.php/apps/integriq/api"
    },
    {
      "key": "orBase",
      "value": "{{base_url}}/index.php/apps/openregister/api/objects/integriq"
    },
    {
      "key": "idpOrg",
      "value": ""
    },
    {
      "key": "idpUser",
      "value": ""
    },
    {
      "key": "idpUserPassword",
      "value": ""
    },
    {
      "key": "idpOidcUuid",
      "value": ""
    },
    {
      "key": "idpSamlUuid",
      "value": ""
    },
    {
      "key": "idpDisabledUuid",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup (via OpenRegister and the provisioning API)",
      "item": [
        {
          "name": "IB.0 a fresh organisation and a plain user for this run",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/ocs/v1.php/cloud/users?format=json",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"userid\": \"{{idpUser}}\", \"password\": \"{{idpUserPassword}}\"}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh names per run, so nothing an earlier run left behind can answer for this one.",
                  "const run = Date.now() + '-' + Math.random().toString(36).slice(2, 8);",
                  "// The organisation is a uuid (the schema's format); a fresh one per run.",
                  "pm.collectionVariables.set('idpOrg', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('idpUser', 'newman-idp-user-' + run);",
                  "pm.collectionVariables.set('idpUserPassword', 'Nm-' + run + '-Pw!x9');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('user created', () => pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('OCS ok', () => pm.expect(pm.response.json().ocs.meta.statuscode).to.equal(100));"
                ]
              }
            }
          ]
        },
        {
          "name": "IB.1 an enabled OIDC registration (client_secret_basic, so no credential is read)",
          "request": {
            "method": "POST",
            "url": "{{orBase}}/idpRegistration",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"organisation\": \"{{idpOrg}}\", \"provider\": \"eherkenning\", \"kind\": \"oidc-rp\", \"enabled\": true, \"label\": \"newman idp-broker oidc-rp\", \"issuer\": \"https://idp.invalid/newman\", \"clientId\": \"newman-client\", \"clientAuth\": \"client_secret_basic\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('idpOidcUuid', b.uuid || b.id || (b['@self'] && (b['@self'].uuid || b['@self'].id)) || '');",
                  "pm.test('has an id', () => pm.expect(pm.collectionVariables.get('idpOidcUuid')).to.not.be.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "IB.2 an enabled SAML registration whose signing credential does not exist",
          "request": {
            "method": "POST",
            "url": "{{orBase}}/idpRegistration",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"organisation\": \"{{idpOrg}}\", \"provider\": \"digid\", \"kind\": \"saml-sp\", \"enabled\": true, \"label\": \"newman idp-broker saml-sp\", \"idpMetadataUrl\": \"https://idp.invalid/newman/metadata\", \"credentials\": {\"signing\": \"newman-missing-credential\"}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('idpSamlUuid', b.uuid || b.id || (b['@self'] && (b['@self'].uuid || b['@self'].id)) || '');",
                  "pm.test('has an id', () => pm.expect(pm.collectionVariables.get('idpSamlUuid')).to.not.be.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "IB.3 a disabled SAML registration",
          "request": {
            "method": "POST",
            "url": "{{orBase}}/idpRegistration",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"organisation\": \"{{idpOrg}}\", \"provider\": \"eidas\", \"kind\": \"saml-sp\", \"enabled\": false, \"label\": \"newman idp-broker saml-sp\", \"idpMetadataUrl\": \"https://idp.invalid/newman/metadata\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('idpDisabledUuid', b.uuid || b.id || (b['@self'] && (b['@self'].uuid || b['@self'].id)) || '');",
                  "pm.test('has an id', () => pm.expect(pm.collectionVariables.get('idpDisabledUuid')).to.not.be.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Metadata is published per organisation and provider (REQ-IDPC-003)",
      "item": [
        {
          "name": "IB.10 OIDC client metadata answers 200 with the client and its callback",
          "request": {
            "method": "GET",
            "url": "{{ocBase}}/idp/metadata/{{idpOrg}}/eherkenning",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.expect(pm.response.code).to.equal(200));",
                  "const b = pm.response.json();",
                  "pm.test('the client id', () => pm.expect(b.client_id).to.equal('newman-client'));",
                  "pm.test('the auth method', () => pm.expect(b.token_endpoint_auth_method).to.equal('client_secret_basic'));",
                  "pm.test('a callback for the provider', () => pm.expect(b.redirect_uris[0]).to.include('/idp/eherkenning/callback'));",
                  "pm.test('no jwks_uri for a secret-based client', () => pm.expect(b).to.not.have.property('jwks_uri'));",
                  "pm.test('no secret in the document', () => pm.expect(pm.response.text()).to.not.match(/secret\"\\s*:/));"
                ]
              }
            }
          ]
        },
        {
          "name": "IB.11 the JWKS of a secret-based client is not published: 404",
          "request": {
            "method": "GET",
            "url": "{{ocBase}}/idp/jwks/{{idpOrg}}/eherkenning",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('not published: 404, or 429 once misses are throttled', () => pm.expect([404, 429]).to.include(pm.response.code));",
                  "pm.test('no document', () => pm.expect(pm.response.text()).to.not.match(/client_id|EntityDescriptor|\"keys\"/));"
                ]
              }
            }
          ]
        },
        {
          "name": "IB.12 SAML metadata whose certificate cannot be read answers 503, naming no credential",
          "request": {
            "method": "GET",
            "url": "{{ocBase}}/idp/metadata/{{idpOrg}}/digid",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('503', () => pm.expect(pm.response.code).to.equal(503));",
                  "pm.test('the generic message', () => pm.expect(pm.response.json().message).to.equal('The metadata is temporarily unavailable'));",
                  "pm.test('the credential reference stays inside', () => pm.expect(pm.response.text()).to.not.include('newman-missing-credential'));"
                ]
              }
            }
          ]
        },
        {
          "name": "IB.13 a disabled registration answers 404",
          "request": {
            "method": "GET",
            "url": "{{ocBase}}/idp/metadata/{{idpOrg}}/eidas",
