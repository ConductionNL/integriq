                  "pm.test('no document', () => pm.expect(pm.response.text()).to.not.match(/client_id|EntityDescriptor|\"keys\"/));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Only an administrator configures registrations (RBAC on idpRegistration, REQ-IDPC-008)",
      "item": [
        {
          "name": "IB.20 the administrator lists the registrations with their status",
          "request": {
            "method": "GET",
            "url": "{{ocBase}}/idp/registrations",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.expect(pm.response.code).to.equal(200));",
                  "const rows = pm.response.json().registrations || [];",
                  "const ours = rows.filter(r => r.organisation === pm.collectionVariables.get('idpOrg'));",
                  "pm.test('all three of this run are listed', () => pm.expect(ours.length).to.equal(3));",
                  "const saml = ours.find(r => r.provider === 'digid');",
                  "pm.test('each row has a status and a metadata address', () => { pm.expect(saml.status).to.be.a('string'); pm.expect(saml.metadataUrl).to.include('/idp/metadata/'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "IB.21 Test on the SAML registration names the signing credential check and returns no value",
          "request": {
            "method": "POST",
            "url": "{{ocBase}}/idp/registrations/{{idpSamlUuid}}/test",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.expect(pm.response.code).to.equal(200));",
                  "const b = pm.response.json();",
                  "pm.test('checks are listed', () => pm.expect(b.checks).to.be.an('array').that.is.not.empty);",
                  "pm.test('the credential reference is not echoed as a value', () => pm.expect(JSON.stringify(b.checks)).to.not.match(/BEGIN (CERTIFICATE|PRIVATE KEY)/));"
                ]
              }
            }
          ]
        },
        {
          "name": "IB.22 Test on an unknown id answers 404",
          "request": {
            "method": "POST",
            "url": "{{ocBase}}/idp/registrations/00000000-0000-4000-8000-000000000000/test",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.expect(pm.response.code).to.equal(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "IB.23 a signed-in user who is no administrator cannot list them",
          "request": {
            "method": "GET",
            "url": "{{ocBase}}/idp/registrations",
            "header": [],
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{idpUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{idpUserPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refused', () => pm.expect([401, 403]).to.include(pm.response.code));",
                  "pm.test('no registration in the answer', () => pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('idpOrg')));"
                ]
              }
            }
          ]
        },
