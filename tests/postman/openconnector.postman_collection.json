        {
          "name": "GET /api/objects/openconnector/rule — list rules",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/index.php/apps/openregister/api/objects/openconnector/rule", "host": ["{{baseUrl}}"], "path": ["index.php","apps","openregister","api","objects","openconnector","rule"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200))"], "type": "text/javascript" }}]
