        {
          "name": "GET /api/objects/openconnector/synchronization — list synchronizations",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/index.php/apps/openregister/api/objects/openconnector/synchronization", "host": ["{{baseUrl}}"], "path": ["index.php","apps","openregister","api","objects","openconnector","synchronization"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200))"], "type": "text/javascript" }}]
