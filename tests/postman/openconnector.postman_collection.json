        {
          "name": "GET /api/objects/openconnector/call_log — list call logs",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/index.php/apps/openregister/api/objects/openconnector/call_log", "host": ["{{baseUrl}}"], "path": ["index.php","apps","openregister","api","objects","openconnector","call_log"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200))"], "type": "text/javascript" }}]
        }
      ]
    },
    {
      "name": "02 — Source actions (connector-specific)",
      "item": [
        {
          "name": "POST /api/sources/test/{id} — test connection (404 expected on missing id)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/index.php/apps/openconnector/api/sources/test/00000000-0000-0000-0000-000000000000", "host": ["{{baseUrl}}"], "path": ["index.php","apps","openconnector","api","sources","test","00000000-0000-0000-0000-000000000000"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 — non-existent uuid handled gracefully', () => pm.expect([404, 400, 500]).to.include(pm.response.code));"
          ], "type": "text/javascript" }}]
        },
        {
          "name": "GET /api/sources/logs — list source-related call logs",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/index.php/apps/openconnector/api/sources/logs?_limit=5", "host": ["{{baseUrl}}"], "path": ["index.php","apps","openconnector","api","sources","logs"], "query": [{ "key": "_limit", "value": "5" }] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200))"], "type": "text/javascript" }}]
