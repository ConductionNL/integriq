    {
      "name": "4. The call log (REQ-MCPX-002)",
      "item": [
        {
          "name": "The call log names the method and the tool, without the arguments",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Call log readable', () => pm.response.to.have.status(200));",
                  "const up = pm.collectionVariables.get('mcpUp') === 'true';",
                  "const entries = pm.response.json().results || [];",
                  "(up ? pm.test : pm.test.skip)('REQ-MCPX-002: every relayed call is logged with its JSON-RPC method', () => {",
                  "    const methods = entries.map(e => e.mcpMethod);",
                  "    pm.expect(methods).to.include('initialize');",
                  "    pm.expect(methods).to.include('tools/list');",
                  "    pm.expect(methods).to.include('tools/call');",
                  "});",
                  "(up ? pm.test : pm.test.skip)('REQ-MCPX-002: a tool call names its tool', () => {",
                  "    const tools = entries.filter(e => e.mcpMethod === 'tools/call').map(e => e.mcpTool);",
                  "    pm.expect(tools).to.include('search');",
                  "    pm.expect(tools).to.include('stream');",
                  "});",
                  "(up ? pm.test : pm.test.skip)('REQ-MCPX-002: the refused search never reached the tool server (two search entries)', () => {",
                  "    const limited = pm.collectionVariables.get('mcpLimited') === 'true';",
                  "    pm.expect(entries.filter(e => e.mcpTool === 'search').length).to.eql(limited ? 2 : 3);",
                  "});",
                  "(up ? pm.test : pm.test.skip)('REQ-MCPX-002: tool arguments are not stored', () => pm.expect(JSON.stringify(entries)).to.not.include('newman-private-argument'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "OCS-APIRequest",
                "value": "true"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/openregister/api/objects/integriq/call_log?source={{mcpSourceUuid}}&_limit=50",
            "auth": {
