    },
    {
      "name": "2. The relay (REQ-MCPX-001)",
      "item": [
        {
          "name": "initialize reaches the tool server and its session comes back",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const up = pm.response.code === 200 && pm.response.headers.get('Mcp-Session-Id') === 'mock-session-1';",
                  "pm.collectionVariables.set('mcpUp', up ? 'true' : 'false');",
                  "if (up === false) {",
                  "    console.log('initialize answered ' + pm.response.code + ': no mock tool server at mcpUpstream. Relay checks skipped.');",
                  "}",
                  "pm.test('REQ-MCPX-001: a call with the key passes authentication', () => pm.expect(pm.response.code).to.not.be.oneOf([401, 403]));",
                  "(up ? pm.test : pm.test.skip)('REQ-MCPX-001: the tool server status comes back (200, not the gateway 502)', () => pm.response.to.have.status(200));",
                  "(up ? pm.test : pm.test.skip)('REQ-MCPX-001: the tool server answer comes back untouched', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.eql(1);",
                  "    pm.expect(body.result.serverInfo.name).to.eql('mock-mcp');",
                  "});",
                  "(up ? pm.test : pm.test.skip)('REQ-MCPX-001: the content type is the tool server one', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{mcpKey}}"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "MCP-Protocol-Version",
                "value": "2025-06-18"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/{{mcpEndpointPath}}",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"initialize\", \"params\": {\"protocolVersion\": \"2025-06-18\", \"capabilities\": {}, \"clientInfo\": {\"name\": \"newman\", \"version\": \"1\"}}}"
            }
          }
        },
