        {
          "name": "The tool server gets the session headers, never the caller key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const up = pm.collectionVariables.get('mcpUp') === 'true';",
                  "(up ? pm.test : pm.test.skip)('REQ-MCPX-001: the session headers reach the tool server; the caller key does not', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const seen = JSON.parse(pm.response.json().result.content[0].text);",
                  "    pm.expect(seen['mcp-session-id']).to.eql('mock-session-1');",
                  "    pm.expect(seen['mcp-protocol-version']).to.eql('2025-06-18');",
                  "    pm.expect(seen).to.not.have.property('authorization');",
                  "    pm.expect(JSON.stringify(seen)).to.not.include(pm.collectionVariables.get('mcpKey'));",
                  "});"
                ]
              }
            }
