          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{mcpKey}}"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "MCP-Protocol-Version",
                "value": "2025-06-18"
              },
              {
                "key": "Mcp-Session-Id",
                "value": "mock-session-1"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/index.php/apps/integriq/api/endpoint/{{mcpEndpointPath}}",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 3, \"method\": \"tools/call\", \"params\": {\"name\": \"headers\", \"arguments\": {}}}"
            }
          }
        },
        {
          "name": "An event stream comes back as events",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const up = pm.collectionVariables.get('mcpUp') === 'true';",
                  "(up ? pm.test : pm.test.skip)('REQ-MCPX-001: the answer is the tool server event stream', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');",
