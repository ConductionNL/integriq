    {
      "name": "List informatieobjecttypen: the paged envelope, the definitive type only",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/index.php/apps/integriq/catalogi/api/v1/informatieobjecttypen",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ctReaderJwt}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('the paged envelope', () => {",
              "    pm.expect(b).to.have.all.keys('count', 'next', 'previous', 'results');",
              "    pm.expect(b.results).to.be.an('array');",
              "});",
              "const ids = b.results.map(r => r.uuid);",
              "pm.test('the definitive type is listed', () => pm.expect(ids).to.include(pm.collectionVariables.get('ctType')));",
              "pm.test('the concept type is not', () => pm.expect(ids).to.not.include(pm.collectionVariables.get('ctConcept')));",
              "pm.test('count matches the rows', () => pm.expect(b.count).to.eql(1));",
              "const row = b.results.find(r => r.uuid === pm.collectionVariables.get('ctType')) || {};",
              "pm.test('every url is absolute and served here', () => {",
              "    pm.expect(row.url).to.match(/^https?:\\/\\//);",
              "    pm.expect(row.url).to.include('/apps/integriq/catalogi/api/v1/informatieobjecttypen/' + row.uuid);",
              "    pm.expect(row.catalogus).to.include('/apps/integriq/catalogi/api/v1/catalogussen/' + pm.collectionVariables.get('ctCatalogusUuid'));",
              "});",
              "pm.collectionVariables.set('ctTypeUrl', row.url || '');",
              "pm.collectionVariables.set('ctCatalogusUrl', row.catalogus || '');",
              "pm.collectionVariables.set('ctCount', String(b.count));"
            ]
          }
        }
      ]
    },
