{
  "info": {
    "name": "Integriq — Catalogi API facade (zgw-catalogi-served)",
    "description": "zgw-catalogi-served task 5, the Newman half. A Documenten API client with an HS256 ZGW JWT and the scope `catalogi.lezen` lists informatieobjecttypen in the paged envelope, follows a type's own `url` and its `catalogus` URL and gets the same resources back, filters on `catalogus`; a concept type stays hidden from a client without concept reads; a client whose binding entry lacks `catalogi.lezen` gets 403, no token gets 401; POST, PUT, PATCH and DELETE answer 405 and write nothing. A register and schema of document types, two JWT consumers and a `catalogi_binding` are staged through OpenRegister's APIs under this run's marker and deleted again. Precondition: no other `catalogi_binding` resolves on the instance (the first request checks it and stops the run otherwise). The unconfigured 404, the refused write path and the Woo starter set are also covered by PHPUnit and by `tests/e2e/zgw-catalogi-served.spec.ts`. Run with `tests/postman/integriq.postman_environment.json`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{admin_user}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{admin_password}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A fresh HS256 ZGW JWT per request for both clients; the credential bridge caps the lifetime and refuses a replayed jti.",
          "const stamp = pm.collectionVariables.get('ctStamp');",
          "if (stamp) {",
          "    const b64url = (wa) => CryptoJS.enc.Base64.stringify(wa).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "    const enc = (o) => b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(o)));",
          "    const sign = (client, secret) => {",
          "        const now = Math.floor(Date.now() / 1000);",
          "        const head = enc({ alg: 'HS256', typ: 'JWT' });",
          "        const body = enc({ iss: client, client_id: client, sub: client, iat: now, nbf: now - 5, exp: now + 300, jti: client + '-' + now + '-' + Math.floor(Math.random() * 1e9) });",
          "        return head + '.' + body + '.' + b64url(CryptoJS.HmacSHA256(head + '.' + body, secret));",
          "    };",
          "    pm.collectionVariables.set('ctReaderJwt', sign(pm.collectionVariables.get('ctReader'), pm.collectionVariables.get('ctReaderSecret')));",
          "    pm.collectionVariables.set('ctOtherJwt', sign(pm.collectionVariables.get('ctOther'), pm.collectionVariables.get('ctOtherSecret')));",
          "}"
        ]
      }
    }
  ],
  "variable": [],
  "item": [
    {
      "name": "Precondition: no catalogue resolves yet (the gate answers 404 catalogue-not-configured before it asks for a token)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/index.php/apps/integriq/catalogi/api/v1/informatieobjecttypen",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const stamp = Date.now().toString(36);",
              "pm.collectionVariables.set('ctStamp', stamp);",
              "pm.collectionVariables.set('ctRegister', 'newman-zcs-' + stamp + '-documenten');",
              "pm.collectionVariables.set('ctSchemaSlug', 'newman-zcs-' + stamp + '-documenttype');",
              "pm.collectionVariables.set('ctReader', 'newman-zcs-' + stamp + '-reader');",
              "pm.collectionVariables.set('ctOther', 'newman-zcs-' + stamp + '-other');",
              "// HS256 secrets of at least 32 bytes: the credential bridge refuses a shorter one.",
              "pm.collectionVariables.set('ctReaderSecret', 'newman-zcs-' + stamp + '-' + pm.variables.replaceIn('{{$guid}}') + pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('ctOtherSecret', 'newman-zcs-' + stamp + '-' + pm.variables.replaceIn('{{$guid}}') + pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('ctCatalogusUuid', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const configured = pm.response.code !== 404;",
              "pm.test('no other catalogi_binding resolves on this instance', () => {",
              "    pm.expect(pm.response.code, 'a binding already resolves; this collection would read another catalogue').to.eql(404);",
              "    pm.expect(pm.response.json().code).to.eql('catalogue-not-configured');",
              "});",
              "if (configured) { postman.setNextRequest(null); }"
            ]
          }
        }
      ]
    },
