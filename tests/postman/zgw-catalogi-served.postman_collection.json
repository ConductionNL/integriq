            "type": "text/javascript",
            "exec": [
              "pm.test('created', () => pm.expect([200, 201]).to.include(pm.response.code));",
              "const b = pm.response.json();",
              "const id = b.uuid || b.id || (b['@self'] && (b['@self'].uuid || b['@self'].id));",
              "pm.expect(id, 'the created id').to.be.a('string').and.not.empty;",
              "pm.collectionVariables.set('ctSchema', String(id));",
              "// A register lists its schemas by numeric id (OpenRegister's register-scoped slug boundary); a uuid there is never resolved.",
