          </tbody>
        </table>
        <div class="cn-rules-editor__footer"><button class="NcButton"><span aria-hidden="true" class="material-design-icon plus-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="20" height="20" viewBox="0 0 24 24"><path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"><!--v-if--></path></svg></span> Add unset rule</button>
        </div>
      </div>
    </div><!-- Options tab (opt-in via \`showOptionsTab\`) -->
  </div><!-- Edit/Create dialog -->
</div>"
`;

