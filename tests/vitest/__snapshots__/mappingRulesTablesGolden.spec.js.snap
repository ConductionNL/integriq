exports[`MappingRulesEditor rule tables > renders empty as recorded 1`] = `
"<div class="cn-rules-editor">
  <div class="CnTabs" aria-label="Transformation rules">
    <!---->
    <!-- Mapping rules tab -->
    <div class="CnTab"><span class="cn-rules-editor__tab-label">Mapping <span class="cn-rules-editor__tab-count">0</span></span>
      <div class="cn-rules-editor__panel">
        <p class="cn-rules-editor__help">Each mapping rule maps a target property to a Twig template that produces its value from the input object. Drag the handle to change rule order — order matters for cascading transformations.</p>
        <p class="cn-rules-editor__empty">No mapping rules yet. Add one to start shaping the output.</p>
        <div class="cn-rules-editor__footer"><button class="NcButton"><span aria-hidden="true" class="material-design-icon plus-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="20" height="20" viewBox="0 0 24 24"><path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"><!--v-if--></path></svg></span> Add mapping rule</button></div>
      </div>
    </div><!-- Cast rules tab -->
    <div class="CnTab"><span class="cn-rules-editor__tab-label">Cast <span class="cn-rules-editor__tab-count">0</span></span>
      <div class="cn-rules-editor__panel">
        <p class="cn-rules-editor__help">Cast rules coerce the value of a property to a specific JSON type after the mapping rules have run.</p>
        <p class="cn-rules-editor__empty">No cast rules yet.</p>
        <div class="cn-rules-editor__footer"><button class="NcButton"><span aria-hidden="true" class="material-design-icon plus-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="20" height="20" viewBox="0 0 24 24"><path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"><!--v-if--></path></svg></span> Add cast rule</button></div>
      </div>
    </div><!-- Unset rules tab -->
    <div class="CnTab"><span class="cn-rules-editor__tab-label">Unset <span class="cn-rules-editor__tab-count">0</span></span>
      <div class="cn-rules-editor__panel">
        <p class="cn-rules-editor__help">Unset rules remove a property from the output object. They only apply when pass-through is enabled.</p>
        <p class="cn-rules-editor__empty">No unset rules yet.</p>
        <div class="cn-rules-editor__footer"><button class="NcButton" disabled=""><span aria-hidden="true" class="material-design-icon plus-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="20" height="20" viewBox="0 0 24 24"><path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"><!--v-if--></path></svg></span> Add unset rule</button>
          <p class="cn-rules-editor__warning">Enable pass-through above to add unset rules.</p>
        </div>
      </div>
    </div><!-- Options tab (opt-in via \`showOptionsTab\`) -->
  </div><!-- Edit/Create dialog -->
</div>"
`;

