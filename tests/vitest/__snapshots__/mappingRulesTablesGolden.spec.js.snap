exports[`MappingRulesEditor rule tables > renders with rules as recorded 1`] = `
"<div class="cn-rules-editor">
  <div class="CnTabs" aria-label="Transformation rules">
    <!---->
    <!-- Mapping rules tab -->
    <div class="CnTab"><span class="cn-rules-editor__tab-label">Mapping <span class="cn-rules-editor__tab-count">3</span></span>
      <div class="cn-rules-editor__panel">
        <p class="cn-rules-editor__help">Each mapping rule maps a target property to a Twig template that produces its value from the input object. Drag the handle to change rule order — order matters for cascading transformations.</p>
        <table class="cn-rules-editor__table">
          <thead>
            <tr>
              <th class="cn-rules-editor__col-handle" aria-hidden="true"></th>
              <th scope="col">Target property</th>
              <th scope="col">Template</th>
              <th scope="col" class="cn-rules-editor__col-actions">Actions</th>
            </tr>
          </thead>
          <tbody data-draggable=".cn-rules-editor__drag-handle">
            <tr tabindex="0" class="cn-rules-editor__row">
              <td class="cn-rules-editor__col-handle"><button type="button" class="cn-rules-editor__drag-handle" aria-label="Drag to reorder" tabindex="-1"><span aria-hidden="true" class="material-design-icon drag-vertical-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="18" height="18" viewBox="0 0 24 24"><path d="M9,3H11V5H9V3M13,3H15V5H13V3M9,7H11V9H9V7M13,7H15V9H13V7M9,11H11V13H9V11M13,11H15V13H13V11M9,15H11V17H9V15M13,15H15V17H13V15M9,19H11V21H9V19M13,19H15V21H13V19Z"><!--v-if--></path></svg></span></button></td>
              <td class="cn-rules-editor__cell-key">a</td>
              <td class="cn-rules-editor__cell-value"><code>{{ x }}</code></td>
              <td class="cn-rules-editor__col-actions"><button class="NcButton" aria-label="Edit rule"><span aria-hidden="true" class="material-design-icon pencil-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="18" height="18" viewBox="0 0 24 24"><path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"><!--v-if--></path></svg></span>
                  <!---->
                </button><button class="NcButton" aria-label="Delete rule"><span aria-hidden="true" class="material-design-icon delete-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="18" height="18" viewBox="0 0 24 24"><path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"><!--v-if--></path></svg></span>
                  <!---->
                </button></td>
            </tr>
            <tr tabindex="0" class="cn-rules-editor__row">
              <td class="cn-rules-editor__col-handle"><button type="button" class="cn-rules-editor__drag-handle" aria-label="Drag to reorder" tabindex="-1"><span aria-hidden="true" class="material-design-icon drag-vertical-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="18" height="18" viewBox="0 0 24 24"><path d="M9,3H11V5H9V3M13,3H15V5H13V3M9,7H11V9H9V7M13,7H15V9H13V7M9,11H11V13H9V11M13,11H15V13H13V11M9,15H11V17H9V15M13,15H15V17H13V15M9,19H11V21H9V19M13,19H15V21H13V19Z"><!--v-if--></path></svg></span></button></td>
              <td class="cn-rules-editor__cell-key">b</td>
              <td class="cn-rules-editor__cell-value"><code>{{ y }}</code></td>
              <td class="cn-rules-editor__col-actions"><button class="NcButton" aria-label="Edit rule"><span aria-hidden="true" class="material-design-icon pencil-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="18" height="18" viewBox="0 0 24 24"><path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"><!--v-if--></path></svg></span>
                  <!---->
                </button><button class="NcButton" aria-label="Delete rule"><span aria-hidden="true" class="material-design-icon delete-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="18" height="18" viewBox="0 0 24 24"><path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"><!--v-if--></path></svg></span>
                  <!---->
