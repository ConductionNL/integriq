          <div class="NcSelect" data-attrs="aria-label-combobox=Type clearable=false inputId=cn-rule-editor-type options=[object Object],[object Object],[object Object],[object Object],[object Object],[object Object],[object Object],[object Object],[object Object],[object Object],[object Object],[object Object],[object Object],[object Object],[object Object],[object Object],[object Object]">
