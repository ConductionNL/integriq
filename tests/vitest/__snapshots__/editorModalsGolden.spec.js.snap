exports[`ConsumerEditorModal > renders an invalid name while saving as recorded 1`] = `
"<div class="NcDialog" data-name="Edit consumer" data-attrs="noClose=true size=normal">
  <div class="cn-consumer-editor">
    <div class="cn-consumer-editor__identity">
      <div class="NcTextField" data-label="Name *" data-value="!!" data-attrs="maxlength=255" data-disabled="yes" data-error="yes" data-helper="A name is required.">
      </div>
      <div class="NcTextArea" data-label="Description" data-value="d" data-attrs="resize=vertical rows=2" data-disabled="yes">
      </div>
    </div>
    <section class="cn-consumer-editor__section">
      <header class="cn-consumer-editor__section-header"><span aria-hidden="true" class="material-design-icon shield-check-outline-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="20" height="20" viewBox="0 0 24 24"><path d="M21,11C21,16.55 17.16,21.74 12,23C6.84,21.74 3,16.55 3,11V5L12,1L21,5V11M12,21C15.75,20 19,15.54 19,11.22V6.3L12,3.18L5,6.3V11.22C5,15.54 8.25,20 12,21M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9"></path></svg></span>
        <h3>Allowed sources</h3>
      </header>
      <div class="cn-consumer-editor__grid">
        <div class="cn-consumer-editor__field"><label for="cn-consumer-editor-domains" class="cn-consumer-editor__label">Allowed domains</label>
          <div class="NcSelect" data-attrs="aria-label-combobox=Allowed domains clearable=true inputId=cn-consumer-editor-domains keepOpen=true multiple=true options= placeholder=example.com, *.example.org taggable=true" data-disabled="yes">
          </div><span class="cn-consumer-editor__helper">Press Enter after each entry. Exact hostname, or a suffix wildcard like *.example.com (which also matches example.com). Matched against the caller's verified reverse DNS, never against a header.</span>
        </div>
        <div class="cn-consumer-editor__field"><label for="cn-consumer-editor-ips" class="cn-consumer-editor__label">Allowed IPs</label>
          <div class="NcSelect" data-attrs="aria-label-combobox=Allowed IPs clearable=true inputId=cn-consumer-editor-ips keepOpen=true multiple=true options= placeholder=203.0.113.4, 10.0.0.0/8 taggable=true" data-disabled="yes">
          </div><span class="cn-consumer-editor__helper">Press Enter after each entry. Exact IPv4/IPv6 address or a CIDR range.</span>
        </div>
      </div>
      <div class="NcNoteCard" data-attrs="type=info">
        <p>The two lists combine as a union — a caller is admitted when it matches an entry in either one, and rejected with HTTP 403 otherwise.</p>
      </div>
    </section>
    <section class="cn-consumer-editor__section">
      <header class="cn-consumer-editor__section-header"><span aria-hidden="true" class="material-design-icon key-outline-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="20" height="20" viewBox="0 0 24 24"><path d="M21 18H15V15H13.3C12.2 17.4 9.7 19 7 19C3.1 19 0 15.9 0 12S3.1 5 7 5C9.7 5 12.2 6.6 13.3 9H24V15H21V18M17 16H19V13H22V11H11.9L11.7 10.3C11 8.3 9.1 7 7 7C4.2 7 2 9.2 2 12S4.2 17 7 17C9.1 17 11 15.7 11.7 13.7L11.9 13H17V16M7 15C5.3 15 4 13.7 4 12S5.3 9 7 9 10 10.3 10 12 8.7 15 7 15M7 11C6.4 11 6 11.4 6 12S6.4 13 7 13 8 12.6 8 12 7.6 11 7 11Z"></path></svg></span>
        <h3>Authentication</h3>
      </header>
      <div class="cn-consumer-editor__field cn-consumer-editor__field--narrow"><label for="cn-consumer-editor-auth-type" class="cn-consumer-editor__label">Authorization type</label>
        <div class="NcSelect" data-attrs="aria-label-combobox=Authorization type clearable=false inputId=cn-consumer-editor-auth-type options=[object Object],[object Object],[object Object],[object Object],[object Object],[object Object]" data-disabled="yes">
        </div><span class="cn-consumer-editor__helper">Inbound callers present a JWT whose issuer matches this consumer's name, verified with the public key below.</span>
      </div>
      <div class="cn-consumer-editor__field"><span class="cn-consumer-editor__label">Authorization configuration</span>
        <div class="CnJsonViewer">
        </div><span class="cn-consumer-editor__helper">Write-only, so it always opens empty — that is not a missing value. Leave it empty to keep the stored credential unchanged.</span>
        <div class="cn-consumer-editor__helper-actions">
          <div class="NcButton" data-attrs="size=small" data-disabled="yes">Insert example
          </div>
          <div class="NcButton" data-attrs="size=small" data-disabled="yes">Clear stored credential
          </div>
        </div>
      </div>
    </section>
    <section class="cn-consumer-editor__section">
      <header class="cn-consumer-editor__section-header"><span aria-hidden="true" class="material-design-icon speedometer-icon" role="img"><svg fill="currentColor" class="material-design-icon__svg" width="20" height="20" viewBox="0 0 24 24"><path d="M12,16A3,3 0 0,1 9,13C9,11.88 9.61,10.9 10.5,10.39L20.21,4.77L14.68,14.35C14.18,15.33 13.17,16 12,16M12,3C13.81,3 15.5,3.5 16.97,4.32L14.87,5.53C14,5.19 13,5 12,5A8,8 0 0,0 4,13C4,15.21 4.89,17.21 6.34,18.65H6.35C6.74,19.04 6.74,19.67 6.35,20.06C5.96,20.45 5.32,20.45 4.93,20.07V20.07C3.12,18.26 2,15.76 2,13A10,10 0 0,1 12,3M22,13C22,15.76 20.88,18.26 19.07,20.07V20.07C18.68,20.45 18.05,20.45 17.66,20.06C17.27,19.67 17.27,19.04 17.66,18.65V18.65C19.11,17.2 20,15.21 20,13C20,12 19.81,11 19.46,10.1L20.67,8C21.5,9.5 22,11.18 22,13Z"></path></svg></span>
        <h3>Limits</h3>
      </header>
      <div class="cn-consumer-editor__grid">
        <div class="cn-consumer-editor__field">
          <div class="NcInputField" data-label="Requests per window" data-value="" data-attrs="min=1 placeholder=60 type=number" data-disabled="yes">
          </div>
        </div>
        <div class="cn-consumer-editor__field">
          <div class="NcInputField" data-label="Window (seconds)" data-value="" data-attrs="min=1 placeholder=60 type=number" data-disabled="yes">
          </div>
        </div>
        <div class="cn-consumer-editor__field">
          <div class="NcInputField" data-label="Quota limit" data-value="" data-attrs="min=1 placeholder=10000 type=number" data-disabled="yes">
          </div>
        </div>
        <div class="cn-consumer-editor__field"><label for="cn-consumer-editor-quota-period" class="cn-consumer-editor__label">Quota period</label>
          <div class="NcSelect" data-attrs="aria-label-combobox=Quota period clearable=true inputId=cn-consumer-editor-quota-period options=[object Object],[object Object],[object Object]" data-disabled="yes">
          </div>
        </div>
      </div><span class="cn-consumer-editor__helper">Both halves of a pair are needed for it to apply — a half-filled rate limit or quota is saved as unlimited. Leave all four empty for no limits at all.</span>
    </section>
  </div>
  <div class="NcButton" data-disabled="yes">Cancel
  </div>
  <div class="NcButton" data-disabled="yes">
    <div class="NcLoadingIcon" data-attrs="size=20">
    </div> Save
  </div>
</div>"
`;

