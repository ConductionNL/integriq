exports[`EventDeliveriesPage bulk bar > steps through the bulk flow as recorded 2`] = `
"<div class="eventDeliveries">
  <div class="eventDeliveries__header">
    <h2>Event deliveries</h2>
    <div class="eventDeliveries__filters">
      <div class="NcSelect" inputlabel="Status" options="failed,abandoned,failed,abandoned,discarded"></div>
      <div class="NcTextField"></div>
      <div class="NcCheckboxRadioSwitch" data-testid="nextcloud-event-filter">Nextcloud event</div>
    </div>
  </div>
  <!--v-if-->
  <table class="eventDeliveries__table" data-testid="deliveries-table">
    <thead>
      <tr>
        <th></th>
        <th scope="col">Event</th>
        <th scope="col">Subscription</th>
        <th scope="col">Action</th>
        <th scope="col">Status</th>
        <th scope="col">Retries</th>
        <th scope="col">Last attempt</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>
          <div class="NcCheckboxRadioSwitch" aria-label="Select delivery a"></div>
        </td>
        <td>—</td>
        <td>s</td>
        <td><span class="eventDeliveries__actionBadge" data-testid="action-kind-badge">webhook</span></td>
        <td><span class="eventDeliveries__badge eventDeliveries__badge--failed">failed</span></td>
        <td>0</td>
        <td></td>
        <td><button class="NcButton">Inspect</button></td>
      </tr>
      <tr>
        <td>
          <div class="NcCheckboxRadioSwitch" aria-label="Select delivery b"></div>
        </td>
        <td>—</td>
        <td>s</td>
        <td><span class="eventDeliveries__actionBadge" data-testid="action-kind-badge">webhook</span></td>
        <td><span class="eventDeliveries__badge eventDeliveries__badge--abandoned">abandoned</span></td>
        <td>0</td>
        <td></td>
        <td><button class="NcButton">Inspect</button></td>
      </tr>
    </tbody>
  </table>
  <!---->
</div>"
`;

