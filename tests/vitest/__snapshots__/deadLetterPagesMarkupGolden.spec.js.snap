exports[`SyncDeadLetterPage bulk bar > steps through the bulk flow as recorded 2`] = `
"<div class="syncDeadLetters">
  <div class="syncDeadLetters__header">
    <h2>Sync dead letters</h2>
    <div class="syncDeadLetters__filters">
      <div class="NcSelect" inputlabel="Status" options="failed,replayed,discarded"></div>
      <div class="NcTextField"></div>
    </div>
  </div>
  <!--v-if-->
  <table class="syncDeadLetters__table" data-testid="dead-letters-table">
    <thead>
      <tr>
        <th></th>
        <th scope="col">Synchronization</th>
        <th scope="col">Origin ID</th>
        <th scope="col">Status</th>
        <th scope="col">Retries</th>
        <th scope="col">Created</th>
        <th scope="col">Error</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>
          <div class="NcCheckboxRadioSwitch" aria-label="Select dead letter a"></div>
        </td>
        <td>y</td>
        <td>—</td>
        <td><span class="syncDeadLetters__badge syncDeadLetters__badge--failed">failed</span></td>
        <td>0</td>
        <td></td>
        <td class="syncDeadLetters__errorCell"></td>
        <td><button class="NcButton">Inspect</button></td>
      </tr>
      <tr>
        <td>
          <div class="NcCheckboxRadioSwitch" aria-label="Select dead letter b"></div>
        </td>
        <td>y</td>
        <td>—</td>
        <td><span class="syncDeadLetters__badge syncDeadLetters__badge--abandoned">abandoned</span></td>
        <td>0</td>
        <td></td>
        <td class="syncDeadLetters__errorCell"></td>
        <td><button class="NcButton">Inspect</button></td>
      </tr>
    </tbody>
  </table>
  <!---->
</div>"
`;
