exports[`EndpointFormFields > renders every widget as recorded 1`] = `
"<div class="cn-endpoint-form-fields">
  <div class="cn-endpoint-form-fields__field">
    <div class="NcTextField" data-label="Label text *" data-value="hello" data-placeholder=""></div>
    <p class="CnFieldHelper" data-more="More on text"></p>
  </div>
  <div class="cn-endpoint-form-fields__field">
    <div class="NcTextField" data-label="Label email" data-value="" data-disabled="yes" data-placeholder=""></div>
    <p class="CnFieldHelper" data-text="About email"></p>
  </div>
  <div class="cn-endpoint-form-fields__field">
    <div class="NcTextField" data-label="Label url *" data-value="" data-placeholder=""></div>
    <p class="CnFieldHelper"></p>
  </div>
  <div class="cn-endpoint-form-fields__field">
    <div class="NcTextField" data-label="Label date" data-value="" data-placeholder=""></div>
    <p class="CnFieldHelper" data-text="About date" data-more="More on date"></p>
  </div>
  <div class="cn-endpoint-form-fields__field">
    <div class="NcTextField" data-label="Label datetime *" data-value="" data-placeholder=""></div>
    <p class="CnFieldHelper"></p>
  </div>
  <div class="cn-endpoint-form-fields__field">
    <div class="NcTextField" data-label="Label number" data-value="0" data-error="yes" data-disabled="yes" data-placeholder=""></div>
    <p class="CnFieldHelper" data-text="About number" data-error="bad"></p>
  </div>
  <div class="cn-endpoint-form-fields__field">
    <div class="cn-endpoint-form-fields__textarea-wrapper"><label for="cn-endpoint-form-e_textarea" class="cn-endpoint-form-fields__label">Label textarea *</label><textarea id="cn-endpoint-form-e_textarea" class="cn-endpoint-form-fields__textarea" rows="3" value="long"></textarea>
      <p class="CnFieldHelper" data-more="More on textarea"></p>
    </div>
  </div>
  <div class="cn-endpoint-form-fields__field">
    <div class="NcCheckboxRadioSwitch" data-value="true" data-type="switch">Label checkbox</div>
  </div>
  <div class="cn-endpoint-form-fields__field">
    <div class="NcTextField" data-label="Label json *" data-value="" data-placeholder=""></div>
    <p class="CnFieldHelper"></p>
  </div>
  <div class="cn-endpoint-form-fields__field">
    <div class="NcTextField" data-label="Label other" data-value="42" data-error="yes" data-disabled="yes" data-placeholder=""></div>
    <p class="CnFieldHelper" data-text="About other" data-more="More on other" data-error="worse"></p>
  </div>
  <fieldset class="cn-endpoint-form-fields__validation">
    <legend class="cn-endpoint-form-fields__label">Message validation</legend>
    <div class="NcSelect" data-label="Mode" data-value="[object Object]"></div>
    <div class="NcSelect" data-label="Request schema"></div>
    <div class="NcSelect" data-label="Answer schema"></div>
    <p class="CnFieldHelper" data-text="Record lets the message through and logs the errors. Refuse stops it"></p>
  </fieldset>
  <fieldset class="cn-endpoint-form-fields__validation">
    <legend class="cn-endpoint-form-fields__label">Response cache</legend>
    <div class="NcCheckboxRadioSwitch" data-value="false" data-type="switch">Cache answers</div>
    <p class="CnFieldHelper" data-text="Answers to GET and HEAD from a source are kept for the lifetime, per consumer unless shared. Answers the source marks private or no-store are never kept."></p>
  </fieldset>
</div>"
`;

