    <div class="NcCheckboxRadioSwitch" data-value="true" data-type="switch">Label checkbox</div>
  </div>
  <div class="cn-source-form-fields__field">
    <div class="cn-source-form-fields__textarea-wrapper"><label for="cn-source-form-s_json" class="cn-source-form-fields__label">Label json *</label><textarea id="cn-source-form-s_json" class="cn-source-form-fields__textarea cn-source-form-fields__textarea--code" spellcheck="false" rows="5" value=""></textarea>
      <p class="CnFieldHelper"></p>
    </div>
  </div>
  <div class="cn-source-form-fields__field">
    <div class="NcTextField" data-label="Label other" data-value="42" data-error="yes" data-disabled="yes" data-placeholder="About other"></div>
    <p class="CnFieldHelper" data-text="About other" data-more="More on other" data-error="worse"></p>
  </div>
  <div class="cn-source-form-fields__field cn-source-form-fields__broker">
    <div class="NcCheckboxRadioSwitch" data-value="false" data-type="switch">Brokered credential (OpenRegister)</div><span class="cn-source-form-fields__helper">Reference a credential held by the OpenRegister credential broker instead of storing a secret on this source. The secret never enters Integriq.</span>
  </div>
</div>"
`;
