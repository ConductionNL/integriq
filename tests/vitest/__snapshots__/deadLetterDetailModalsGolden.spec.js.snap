exports[`sync item detail > renders the full detail 1`] = `
"<div class="NcModal" data-testid="sync-dead-letter-detail-modal">
  <div class="deadLetterDetail">
    <h2>Sync dead letter</h2>
    <div class="deadLetterDetail__body">
      <div class="deadLetterDetail__meta"><span class="deadLetterDetail__badge deadLetterDetail__badge--failed">failed</span><span class="deadLetterDetail__retry">Attempts: 3</span></div>
      <div class="deadLetterDetail__audit">
        <p>Replayed by alice at 2026-11-01</p>
        <p>Discarded by bob at 2026-11-02</p>
      </div>
      <h3>Error</h3>
      <p class="deadLetterDetail__error">boom</p>
      <h3>Attempt timeline</h3>
      <ol class="deadLetterDetail__timeline" data-testid="attempt-timeline">
        <li><span class="deadLetterDetail__time">t1</span><span class="deadLetterDetail__attemptOk">OK</span></li>
        <li><span class="deadLetterDetail__time">t2</span><span class="deadLetterDetail__attemptError">timeout</span></li>
        <li><span class="deadLetterDetail__time">t3</span><span class="deadLetterDetail__attemptOk">OK</span></li>
      </ol>
      <h3>Payload</h3><pre class="deadLetterDetail__payload" data-testid="payload-viewer">{
  "a": 1,
  "nested": {
    "b": [
      1,
      2
    ]
  }
}</pre>
    </div>
    <div class="deadLetterDetail__actions"><button class="NcButton">Replay</button><button class="NcButton">Discard</button></div>
  </div>
</div>"
`;
