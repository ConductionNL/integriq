exports[`OpenFormulierenConnectionSettings > loads a full configuration 2`] = `
"<div class="integriq-admin__section" data-testid="admin-openformulieren-section">
  <h3>Open Formulieren connection</h3>
  <p class="integriq-admin__hint">Open Formulieren signs every submission with a shared secret. Integriq checks the signature and stores the submission as the account you choose here.</p>
  <!--v-if-->
  <div class="integriq-admin__openformulieren-form">
    <p class="integriq-admin__hint" data-testid="admin-openformulieren-account-state">Intake acts as Intake Bot</p>
    <div class="NcNoteCard" data-testid="admin-openformulieren-handlers-empty">Nobody can read the submissions yet. Add handlers to the group of-handlers under Accounts.</div>
    <div class="NcSelectUsers" data-testid="admin-openformulieren-account" data-label="Account the intake acts as"></div>
    <!--v-if-->
    <div class="NcSelect" data-testid="admin-openformulieren-scheme" data-label="Signature scheme"></div><label for="openformulieren-secret">Shared secret</label>
    <div class="NcPasswordField" data-testid="admin-openformulieren-secret" data-placeholder="Configured (leave blank to keep unchanged)"></div>
    <div class="NcTextField" data-testid="admin-openformulieren-header" data-label="Signature header"></div>
    <div class="NcTextField" data-testid="admin-openformulieren-tolerance" data-label="Allowed clock difference in seconds"></div>
  </div>
  <div class="integriq-admin__matrix-actions"><button class="NcButton" data-testid="admin-openformulieren-save" data-disabled="false">Save Open Formulieren connection</button></div>
</div>"
`;

