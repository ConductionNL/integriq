      "name": "Example REST API",
      "description": "Placeholder REST source pointing at example.com. Replace `location` and `apikey` before enabling.",
      "type": "api",
      "location": "https://api.example.com",
      "auth": "apikey",
      "apikey": "YOUR_API_KEY_HERE",
      "isEnabled": false,
      "test": true,
      "version": "1.0.0"
    },
    {
      "@self": { "register": "openconnector", "schema": "source", "slug": "example-basic-auth" },
      "name": "Example Basic Auth Source",
