    {
      "@self": { "register": "openconnector", "schema": "source", "slug": "bank-aggregator-sandbox" },
      "name": "Bank Aggregator Sandbox (PSD2 AIS)",
      "description": "Sandbox PSD2 AIS aggregator (log/mock provider). Demonstrates the full connect -> callback -> discovery -> sync -> synced-event path with no real aggregator and no credential. Switch `configuration.provider` to `rest`, set `configuration.baseUrl`, and add `configuration.authentication.credentialRef` (GoCardless Bank-Account-Data-style API) for production.",
