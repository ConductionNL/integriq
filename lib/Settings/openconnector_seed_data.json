      "@self": { "register": "openconnector", "schema": "source", "slug": "peppol-sandbox" },
      "name": "Peppol Sandbox Access Point",
      "description": "Sandbox Peppol Access Point (log/mock provider). Demonstrates participant lookup and document transmission with no real AP or credential. Switch `configuration.provider` to `rest`, set `configuration.baseUrl`, and add `configuration.authentication.credentialRef` for production.",
