<?xml version="1.0" encoding="utf-8"?>
<!-- Version 3.0 - June 2010 -->
<xs:schema xmlns:ns0="http://schemas.rdw.nl/GEB/BerichtVerwerkService/Shared/Types/2009/01" xmlns="http://schemas.rdw.nl/GEB/BerichtVerwerkService/BerichtResultaat/Types/2009/01" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://schemas.rdw.nl/GEB/BerichtVerwerkService/BerichtResultaat/Types/2009/01">
	<xs:simpleType name="guid">
		<xs:restriction base="xs:string">
			<xs:pattern value="[\da-fA-F]{8}-[\da-fA-F]{4}-[\da-fA-F]{4}-[\da-fA-F]{4}-[\da-fA-F]{12}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:element name="Bericht">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="BerichtID" type="guid"/>
				<xs:element name="BerichtType" type="xs:string"/>
				<xs:element name="VerwerkingsCode">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							 <xs:enumeration value="Verwerkt" />
							 <xs:enumeration value="TechnischProbleem" />
							 <xs:enumeration value="NietActiefOfGeabonneerd" />
							 <xs:enumeration value="BerichtTypeNietOndersteund" />
							 <xs:enumeration value="PublicatieDatumLigtTeVerInDeToekomst" />
							 <xs:enumeration value="AanmaakDatumLigtTeVerInHetVerleden" />
							 <xs:enumeration value="BerichtBestaatAl" />
							 <xs:enumeration value="BijlageTeGroot" />
							 <xs:enumeration value="OinInCPAKomtNietOvereenMetOinInBericht" />
							 <xs:enumeration value="XmlValidatieTegenXsdValtNegatiefUit" />
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Stadium" type="xs:string" nillable="true" minOccurs="0">
					<xs:annotation>						
						<xs:documentation>Als er NA (Not Applicable) is ingevult dan is er geen probleem op getreden. Een andere waarde is van belang voor de exploitant en geeft aan waar in het proces een technisch probleem is opgetreden.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
